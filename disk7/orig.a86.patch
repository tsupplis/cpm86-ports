--- orig.a86
+++ orig.a86
@@ -177,7 +177,12 @@
 	RCL	SI,1
 	MOV	Word Ptr STACK,BX
 ;not warmboot
+; CP/M-86: the program starts on the CCP's stack, switch SS to our segment
+	MOV	AX,DS
+	CLI
+	MOV	SS,AX
 	MOV	SP,(Offset STACK)	;start local stack
+	STI
 	CALL	HELP			;show 'menu'
 	MOV	DL,GET			;determine..
 	CALL	GET@USR			;..user area then..
@@ -1875,19 +1875,19 @@
 	ADD	AL,'A'-1		;make printable and..
