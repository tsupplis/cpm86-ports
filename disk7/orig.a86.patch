 	MOV	CL,GETPARM		;current disk parameter block
-	INT	224
+	INT	224			;CP/M-86: returned in ES:BX
 	INC	BX			;bump to..
 	INC	BX
-	MOV	AL,M			;..block shift factor.
+	MOV	AL,ES:M			;..block shift factor.
 	MOV	Byte Ptr BSHIFTF,AL	; 'bsh'
 	INC	BX			;bump to..
