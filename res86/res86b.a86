	CALL	PSTG
	DB	'WORD PTR ',0
	OR	OPDTYP,02H	;WORD SIZE
	JMP	L1630
;
L18BA:	CALL	PSGPRF
	CALL	PSTG
	DB	'WORD PTR ',0
	OR	OPDTYP,02H	;WORD SIZE
	JMP	L1679
