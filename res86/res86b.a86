	JZ	L19BC
	CMP	AL,8		;DEC REG/MEM WORD
	JZ	L19BC
	CMP	AL,30H		;PUSH REG/MEM
	JZ	L19DA
	CMP	AL,18H		;INDIR INTERSEG CALL
