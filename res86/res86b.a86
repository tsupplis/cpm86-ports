	MOV	BX,CURADR
	INC	BX
	MOV	AL,ES:[BX]
	AND	AL,0C0H
	CMP	AL,0C0H
	JZ	L1895
	CMP	AL,0
	JZ	L18A1
	JMP	L18A4
;
L1895:	MOV	BX,CURADR
	INC	BX
	MOV	AL,ES:[BX]
	AND	AL,7
	JMP	NAMR16
