KIND33:	INC	BX
	MOV	AL,ES:[BX]	;2ND INSTR BYTE
	AND	AL,38H		;SUB-OPCODE
	CMP	AL,38H
	JNZ	L199F
	JMP	L1C16		;MAKE DB, NOT INSTR
