
M	EQU	Byte Ptr 0[BX]
;	TITLE 'MICRO RESOURCES "WASH" Directory Maintence Utility Ver 1.4'
;*************************************************************************
;    MICRO RESOURCES "WASH"; THE SUPER DIRECTORY MAINTENANCE UTILITY
;*************************************************************************
;
;
;	This program is a super-duper CP/M disk directory maintence
;	utility that is designed as an "almost" all inclusive routine
;	to make it easy to do disk directory house keeping. The
;	inspiration to produce this program came from use of an older
;	utility program called "CLEAN" that I came across at a meeting of
;	the Valley Computer Club about a year and a half ago. At that
;	time "CLEAN" seemed like a dream come true. Unfortunately it
;	had several major problems that limited its overall usefullness.
;	The disadvantages of CLEAN have all been overcome with the new
;	WASH program. Program features are listed below:
;
;		a) Alphabetical list oriented file operations
;
;		b) Any legal CP/M drive (A: to P:) may be selected
;
;		c) Operator interface to the file list is at the console
;		   in sequential apha order in forward or backup mode.
;
;		d) The file list is treated as a circular buffer. Forward
;		   or backward scanning of the list wraps around the list
;		   back to the beginning or ending respectively.
;
;		e) The current list position file can be viewed at the
;		   Console, printed on the CP/M List device, or sent
;		   to the CP/M Punch device.
;
;		f) The current list position file may be deleted or renamed.
;		   If renamed, only the new name must be entered.
;
;		g) The current list position file may be copied, with the
;		   same name, to any other operator selected disk drive.
;		   The copy utilizes all of available memory as the copy
; 		   buffer for the ultimate in copy speed.
;
;	      	h) The current list can be deleted and the "WASH" operation
;		   may be begun upon another operator selected disk drive.
;
;		i) The program is fully implemented in 8080 assembly language
;		   for speed, small size, and portability to any CP/M 2.2
;		   or 1.4 system. No assumption is made upon the maximum
;		   number of directory files other than available memory
;		   space for the list. (A directory with 1024 directory
;		   file names takes 12 K bytes of storage. Assuming the
;		   copy buffer minimum size requirement of 128 bytes, then
;		   WASH should easily run in the minimum CP/M 2.2 20K
;		   System with no problems at all.) ALL directory and
;		   disk I/O is handled through calls to the BDOS. This
;		   will guarentee WASH compatibility with any CP/M system
;		   implementation. This makes the program disk media
;		   independent (all you have to do is get WASH.COM onto
;		   your diskette or hard disk in the first place.
;
;	Complete documentation on the operation of WASH is given in the
;	accompaning documentation file "WASH.DOC". For the most part the
;	program is self documenting and contains extensive error message
;	reporting.
;
;
;		This Program was Written by:
;
;		Michael J. Karas
;		MICRO RESOURCES
;		2468 Hansen Court
;		Simi Valley, California 93065
;		(805) 527-7299
;		September 20, 1981
;
;	NOTE:  The WASH program, its source code, documentation file,
;	       and object code, has been released to the PUBLIC DOMAIN
;	       by Michael J. Karas. This program may be modified to suit
;	       your personal requirements or those of your friends. In
;	       any case no COMMERCIAL or MONEY MAKING ventures with
;	       regard to SOFTWARE SALES or MODIFICATION and the subsequent
;	       SALE of the WASH program in WHOLE or any PART is permitted
;	       by the author. Further modification and public domain
;	       distribution of the WASH program must include:
;			a) This NOTE,
;			b) The name "WASH" must be retained,
;			c) The original authorship notice
;			   from above, and
;			d) The MICRO RESOURCES Name in the Sign-on
;			   Menu.
;
;	MICRO RESOURCES reserves the right to modify this program at any
;	time for any purpose. The Intent of the above NOTE is intended
;	for the public domain distribution of the WASH program and
;	MICRO RESOURCES reserves the right to utilize the WASH program
;	for any application whatsoever including but not limited to
;	commercial distribution and modification for custom applications
;	with or without the "WASH" name.
;
;
;
;	Modification History:
;
;	If you modify, enhance, or correct bugs in this program, please
;	include a short statement of the modifications done and include
;	your name and the date. The modification history log should be
;	kept intact with this source code in "most recent first" order.
;	Changes to program structure will generally require a change in
;	the program version. The version number is documented in the
;	signon message and the distribution program name as "WASH-10.ASM"
;	in the specific case of the initial release 1.0.
;
;
;
;	11/28/82: Added disk system reset on call to change
;		  drives (S). This allows the user to change
;		  disks with impunity. It simply requires that
;		  before any operation that will write to either
;		  disk the operator must use the <S> command
;		  even if the drive subsequently specified is
;		  the same as the current drive.
;	(No more BDOS ERROR --- R/O)     Version 1.5 Simon J. Ewins
;
;
;
;	Date: Oct 13, 1981  Version Number: 1.4  Bob Zimmerman
;	Changed Delete (D) command to ^D to make deleting files
;	a two-handed operation
;
;	9-26-81 V 1.2 Chuck Forsberg
;
;	Changed BDOS write record call to detect ANY non zero return as
;	error in accordance with CP/M 2.2 documentaion.  This fix should
;	minimize file diversion to the proverbial bit bucket.
;	Other BDOS calls checked for the same error.
;
;
;	Date: Sept. 25, 1981  Version Number: 1.3  Name: Ted Shapin
;
;	Added BASE for standard or modified CP/M systems.  Added BUFR
;	equate for same purpose and to make code clearer.  Shortened long
;	labels to be unique in first six chars.  Fixed code to compute
;	buffer address correctly for BUFR other than at 80H.  Reprint
;	help menu on any unknown command.  Changed abort to stay at same
;	position in list (good for abort while viewing file).
;	CP/M 1.4 always returns 0FFH when
;	deleting a file, therefore after a file was deleted always
;	printed "Not found".  I added a switch to bypass this code.
;
;	Date: Sept. 24, 1981   Version Number: 1.1  Name: Keith B. Petersen
;
;	Fixed problem with incorrect drive select when default disk used
;	and running in other than user 0.  Added code to turn up two new
;	lines to console when entering VIEW mode.
;
;	Date: Sept. 20, 1981   Version Number: 1.0  Name: Michael J. Karas
;
;	Initial release to the public domain via the CP/M NET remote
;	software access program operated by Kelly Smith, 3055 Waco Ave,
;	Simi Valley, CA 93063. (805) 527-9321/ PMMI modem.
;
;******************************************************************************
;
;
;
;
;DEFINE TRUE AND FALSE ASSEMBLY PARAMETERS
;
FALSE	EQU	0			;DEFINE FALSE
TRUE	EQU	NOT FALSE		;DEFINE TRUE
;
BASE	EQU	0H			; 0 FOR STD, 4200H FOR MODIFIED CP/M
BUFR	EQU	80H+BASE		; DEFAULT CP/M BUFFER
CPM14	EQU	FALSE			; TRUE IF RUNNING 1.4
;
;
;CP/M BDOS INTERFACE EQUATES
;
WBOOT	EQU	0+BASE			;WARM BOOT ENTRY ADRS
KEYIN	EQU	1			;CONSOLE INPUT FUNCTION
WRCON	EQU	2			;WRITE CHARACTER TO CONSOLE
WRLST	EQU	5			;WRITE CHARACTER TO FNLIST DEVICE
WRPUN	EQU	4			;WRITE CHARACTER TO PUNCH DEVICE
LOGDRIV	EQU	0004H+BASE		;LOCATION OF CURRENTLY LOGGED DRIVE
BDOS	EQU	0005H+BASE		;THE BDOS I/O VECTOR
PRINT	EQU	9			;PRINT STRING (DE) UNTIL '$'
GETBUF	EQU	10			;READ INPUT STRING
GETST	EQU	11			;GET CONSOLE STATUS
OPEN	EQU	15			;OPEN FILE
CLOSE	EQU	16			;CLOSE FILE
SRCHF	EQU	17			;SEARCH DIR FOR FIRST OCCUR.
SRCHN	EQU	18			;SEARCH DIR FOR NEXT OCCUR.
DELETE	EQU	19			;ERASE FILE
READR	EQU	20			;READ RECORD
WRITER	EQU	21			;WRITE RECORD
MAKE	EQU	22			;MAKE FILE
RENAM	EQU	23			;RENAME FILE
STDMA	EQU	26			;SET DMA ADDRESS
FCB	EQU	5CH+BASE		;DEFAULT FILE CONTROL BLOCK
FCBEXT	EQU	FCB+12			;EXTENT BYTE IN FCB
FCBRNO	EQU	FCB+32			;RECORD NUMBER IN FCB
;
;
;ASCII CHARACTER DEFINITIONS
;
BS	EQU	008H			;ASCII BACK SPACE CHARACTER
LF	EQU	00AH			;ASCII LINE FEED CHARACTER
CR	EQU	00DH			;ASCII CARRIAGE RETURN CHARACTER
ESCCHR	EQU	01BH			;ASCII ESCAPE CHARACTER
RUBOUT	EQU	07FH			;ASCII RUBOUT CHARACTER
EOT	EQU	004H			;ASCII EOT CHARACTER (^D)
;
;*****************************************************************************
;
;
	ORG	0100H+BASE
;
	CLI
	MOV	SP,(Offset STCKK)	;SETUP LOCAL UTILITY STACK
;
RESTART:
	CALL	MENU
;
;
;START UP BY ASSEMBLING FNLIST OF FILE NAMES OF SPECIFIED DISK DRIVE
;
	MOV	AL,Byte Ptr .FCB+1	;CHECK IF A COMMAND PARAMETER WAS ENTERED
	CMP	AL,' '			;..FILE NAME = SPACES?
	JNZ	NAMEPRES		;NAME NOT SPACE SO PARM WAS ENTERED
	MOV	AL,Byte Ptr .FCB+9	;EXTENT NAME ALSO SPACES?
	CMP	AL,' '			;..IF SO THEN MUST TREAT AS *.*
	JNZ	NAMEPRES
;
;
;NO COMMAND PARAMETER FOR A FILE NAME SO SET LIKE *.*
;
	MOV	BX,(Offset ALFN)	;POINT AT ALL FILE WILD CARD NAME
	MOV	DX,FCB+1		;PLACE TO PUT IT
	MOV	CH,11			;SIZE TO SET
	CALL	MOVBYT			;SET FIELD TO *.*
	JMPS	NAMEPRES
L_1	EQU	$
	DSEG
	ORG	Offset L_1
;
ALFN	RS	0
	DB	'???????????'		;DUMMY ALL FILE SPECIFIED NAME
L_2	EQU	$
	CSEG
	ORG	Offset L_2
;
;
;HERE IF NAME PROPERLY POSITIONED IN THE DEFAULT FCB AREA FOR FNLIST BUILD
;
NAMEPRES:
	MOV	CL,STDMA		;INITIALIZE DMA ADDRESS TO DEFAULT BUFFER
	MOV	DX,BUFR
	INT	224
;
	XOR	AL,AL			;CLEAR APPROPIATE FIELDS OF SEARCH FCB
	MOV	Byte Ptr .FCBEXT,AL	;EXTENT BYTE
	MOV	Byte Ptr .FCBRNO,AL	;AND RECORD NUMBER
;
	MOV	DX,FCB			;USE DEFAULT FCB FOR SEARCH
	MOV	CL,SRCHF		;SEARCH FOR FIRST OCCURRANCE
	INT	224
	CMP	AL,0FFH			;SEE IF FOUND
	JZ	L_3	
	JMP	LOADLIST		;IF SOME FOUND THEN GO BUILE FNLIST
L_3:
;
	CALL	PRTMSG			;TELL THEM THAT NONE FOUND
	DB	CR,LF,' ++ Not Found ++',0
	JMP	EXIT
;
;
MENU:
	CALL	PRTMSG			;PRINT SIGNON MESSAGE
;
	DB	CR,LF,' MICRO RESOURCES DIRECTORY "WASH UTILITY" Ver 1.5'
	DB	CR,LF
	DB	CR,LF,'       Command        Function'
	DB	CR,LF,'       -------    ----------------------------'
	DB	CR,LF,'          V       View file at Console'
	DB	CR,LF,'                   (any key aborts)'
	DB	CR,LF,'          L       Print file to List Device'
	DB	CR,LF,'          P       Send file to Punch Device'
	DB	CR,LF,'          C       Copy file to another Disk'
	DB	CR,LF,'          R       Rename file'
	DB	CR,LF,'         ^D       Delete file'
	DB	CR,LF,'          X       Exit to CP/M'
	DB	CR,LF,'          B       Backup one file in List'
	DB	CR,LF,'          S       Reset & restart on another Drive'
	DB	CR,LF,'       sp or cr   Forward to next file in List'
	DB	CR,LF,'          H       Display this help message'
	DB	CR,LF,CR,LF,CR,LF,0
	RET
;
;
;BUILD UP FNLIST WITH ALL FOUND ENTRIES
;
LOADLIST:
	MOV	BX,(Offset FNLIST)	;INITIALIZE FNLIST POINTER PARAMETERS
	MOV	Word Ptr LISTPOS,BX	;START = CURRENT POS OF FNLIST
;
;
;PUT CURRENTLY FOUND NAME TO FNLIST
;(A) = OFFSET IN DEFAULT BUFFER OF NAME
;
;
NM2LST:
	AND	AL,3			;ZERO BASED TWO BIT INDEX
	ADD	AL,AL			;TIMES 32 TO MAKE POSITION INDEX
	ADD	AL,AL
	ADD	AL,AL
	ADD	AL,AL
	ADD	AL,AL
	MOV	CL,AL			;PUT IN BC
	MOV	CH,0			;CLEAR HIGH ORDER (XLT86: MOV CH,0)
	MOV	BX,BUFR			;TO NAME POSITION IN DEFAULT BUFFER
	ADD	BX,CX			;(HL) = CURRENT FOUND NAME POINTER
	MOV	AL,Byte Ptr .FCB	;PUT DISK DRIVE NUMBER INTO NAME PLACE
	OR	AL,AL			;SEE IF DEFAULT DRIVE
	JNZ	NOTDEF			;SKIP SETTING IF NOT DEFAULT
; CP/M-86: no logged drive at 0004h -- ask BDOS fn 25 (return current disk)
	PUSH	BX			;SAVE HL ACROSS BDOS CALL
	MOV	CL,25			;BDOS GET CURRENT DISK FUNCTION
	INT	224
	POP	BX
	AND	AL,0FH			;GET RID OF USER NUMBER
	INC	AL			;MAKE 1 = A:
NOTDEF:
	MOV	M,AL			;INTO BUFFER
	XCHG	BX,DX
	MOV	BX,Word Ptr LISTPOS	;POINTER TO CURRENT LOAD POINT IN FNLIST
	XCHG	BX,DX
	MOV	CH,12			;MOVE DRIVE DESIGNATOR AND NAME TO FNLIST
	CALL	MOVBYT
	XCHG	BX,DX			;(DE) WAS LEFT WITH LEXT LOAD POINT ADDRESS
	MOV	Word Ptr LISTPOS,BX
;
;
;SEARCH FOR NEXT OCCURANCE OF SPECIFIED FILE NAME
;
	MOV	CL,SRCHN		;SEARCH NEXT FUNCTION CODE
	MOV	DX,FCB			;FILE NAME SPECIFICATION FIELD
	INT	224
	CMP	AL,0FFH			;SEE IF ALL THROUGH DIRECTORY YET
	JNZ	NM2LST			;IF NOT GO PUT NAME INTO FNLIST
;
;
;ALL FILE NAMES NOW IN FNLIST SO LETS SETUP PARAMETERS ASSOCIATED
;THE FNLIST SIZE AND COPY BUFFER START POINT.
;
	MOV	BX,Word Ptr LISTPOS	;NEXT LOAD POINT OF FNLIST IS START OF BUFFER
	MOV	Word Ptr LISTEND,BX	;SET FNLIST END MARKER
	MOV	Word Ptr BUFSTART,BX
	MOV	DX,(Offset FNLIST)+12	;COMPARE LISTEND TAB BASE+12
	CALL	CMPDEHL
	JNZ	L_4	
	JMP	CMDST			;GO TO COMMAND WLOOP IF NO SORT
L_4:
;
;
;SORT FNLIST OF FILE NAMES IN ALPHA ORDER AS AN OPERATOR NICEITY
;THIS MAY TAKE A LITTLE WHILE AS THIS IS A VERY SIMPLE SORT ROUTINE
;
SORT:
	MOV	BX,(Offset FNLIST)	;INITIALIZE I SORT VARIABLE
	MOV	Word Ptr LISTI,BX
	MOV	DX,12			;INITIALIZE ALSO THE J VARIABLE
	LAHF
	ADD	BX,DX
	RCR	SI,1
	SAHF
	RCL	SI,1
	MOV	Word Ptr LISTJ,BX
;
SORT1:
	MOV	BX,Word Ptr LISTJ	;COMPARE NAMES I & J
	XCHG	BX,DX
	MOV	BX,Word Ptr LISTI
	PUSH	BX			;SAVE POSITION POINTERS FOR MAYBE SWAP
	PUSH	DX
	MOV	CH,12			;COMPARE SIZE
	CALL	CMPSTR			;GO COMPARE
	POP	DX
	POP	BX
	MOV	CH,12
	JNB	L_5	
	CALL	SWAP			;GO SWAP IF J STRING LARGER THAN I
L_5:
;
	MOV	BX,Word Ptr LISTJ	;INCREMENT J POINTER
	MOV	DX,12
	LAHF
	ADD	BX,DX
	RCR	SI,1
	SAHF
	RCL	SI,1
	MOV	Word Ptr LISTJ,BX
	XCHG	BX,DX			;SEE IF END OF J WLOOP
	MOV	BX,Word Ptr LISTEND
	CALL	CMPDEHL
	JNZ	SORT1			;..NO SO MORE J WLOOP
;
	MOV	BX,Word Ptr LISTI	;BUMP I POINTER
	MOV	DX,12
	LAHF
	ADD	BX,DX
	SAHF
	MOV	Word Ptr LISTI,BX
	LAHF				;SET START OVER J POINTER
	ADD	BX,DX
	RCR	SI,1
	SAHF
	RCL	SI,1
	MOV	Word Ptr LISTJ,BX
	XCHG	BX,DX			;SEE IF END OF I WLOOP
	MOV	BX,Word Ptr LISTEND
	CALL	CMPDEHL
	JNZ	SORT1			;MUST BE MORE I WLOOP TO DO
;
;
;FILE PROCESSING AND DISPLAY WLOOP
;
CMDST:
	MOV	BX,(Offset FNLIST)	;SET START POINT OF LISTING
	MOV	Word Ptr LISTPOS,BX
;
;
;DISPLAY CURRENT FILE POSITION
;
WLOOP:
	MOV	BX,Word Ptr LISTPOS	;MOVE FROM LOCATION
	MOV	DX,(Offset PNAME)	;START POINT OF FNLIST POINT
	MOV	CH,1			;ONE CHARACTER OF DRIVE ID TO MOVE
	CALL	MOVBYT
;
	MOV	DX,(Offset PNAME)+3	;PLACE TO PUT FILE NAME FOR PRINT
	MOV	CH,8			;8 CHARS IN FILE NAME
	CALL	MOVBYT			;MOVE NAME FIELD
;
	MOV	DX,(Offset PNAME)+12	;PLACE TO PUT EXTENSION FOR PRINT
	MOV	CH,3			;3 CHARS IN FILE TYPE
	CALL	MOVBYT			;MOVE TYPE NAME
;
	MOV	Word Ptr LISTPOS,BX	;SAVE NEXT POSITION OF LISTING
;
	MOV	AL,Byte Ptr PNAME	;MAKE DRIVE NAME PRINTABLE
	ADD	AL,'A'-1		;THIS ONE O.K. SO MAKE DRIVE PRINTABLE
	MOV	Byte Ptr PNAME,AL
;
SAMEPOS:
	CALL	PRTMSG			;PRINT CURRENT READY TO TRANSFER FILE NAME
PNAME:
	DB	'X: XXXXXXXX.XXX   : '	;DUMMY FILE NAME PRINTING FIELD
	DB	0
;
	MOV	CL,KEYIN		;CONSOLE CHAR IN FUNCTION
	INT	224			;GET THE CHARACTER
	CALL	UPCASE
	CMP	AL,' '			;IF SPACE THEN ON TO NEXT FILE
	JNZ	L_6	
	JMP	NEXTPOS
L_6:
	CMP	AL,CR			;IF CARRIAGE RETURN THEN ON TO NEXT FILE
	JNZ	L_7	
	JMP	NEXTPOS
L_7:
	CMP	AL,'B'			;IF BACKUP THEN ADJUST POSITION POINTER -1 FILE
	JZ	BACKUP
	CMP	AL,'X'			;IF EXIT THEN TO CP/M
	JNZ	L_8	
	JMP	EXIT
L_8:
	CMP	AL,'R'			;IF RENAME THEN GO DO IT
	JNZ	L_9	
	JMP	RENAME
L_9:
	CMP	AL,EOT			;TO DELETE A FILE IF "^D"
	JNZ	L_10	
	JMP	DELFLE
L_10:
	CMP	AL,'V'			;IF TO VIEW FILE AT CONSOLE
	JNZ	L_11	
	JMP	VIEW
L_11:
	CMP	AL,'L'			;IF TO PRINT FILE TO FNLIST DEVICE
	JNZ	L_12	
	JMP	PRTFIL
L_12:
	CMP	AL,'P'			;IF TO SEND FILE TO THE PUNCH DEVICE
	JNZ	L_13	
	JMP	PUNFIL
L_13:
	CMP	AL,'C'			;IF TO COPY FILE TO ANOTHER DISK
	JNZ	L_14	
	JMP	COPY
L_14:
	CMP	AL,'S'			;IF TO START OVER ON ANOTHER DRIVE
	JNZ	L_15	
	JMP	LOG
L_15:
CMDERR:
	CALL	MENU			;GIVE HELP MESSAGE
	JMPS	SAMEPOS			;STAY IN THIS POSITION
;
BACKUP:
	MOV	BX,Word Ptr LISTPOS	;SEE IF AT BEGINNING OF FNLIST
	MOV	DX,(Offset FNLIST)+12
	CALL	CMPDEHL
	JNZ	BAKUP1			;SKIP POSITION POINTER RESET IF NOT
;..AT BEGINNING
	CALL	PRTMSG
	DB	CR,LF,CR,LF,'      Beginning of List',CR,LF,0
	MOV	BX,Word Ptr LISTEND	;SET TO END +1 TO BACKUP TO END
	MOV	DX,12
	ADD	BX,DX
	MOV	Word Ptr LISTPOS,BX
;
BAKUP1:
	CALL	PRTMSG			;PRINT BACKUP INDICATOR
	DB	CR,LF,'<  ',0
	MOV	BX,Word Ptr LISTPOS
	MOV	DX,12*2			;ONE FNLIST POSITION BACKWARDS SIZE
	CALL	SDEHL			;SUBTRACT
	MOV	Word Ptr LISTPOS,BX
	JMP	WLOOP			;DISPLAY THAT GUY WITHOUT CRLF
;
NEXTPOS:
	CALL	PRTMSG			;DO CARRIAGE RETURN LINE FEED
	DB	CR,LF,0
	MOV	BX,Word Ptr LISTPOS	;SEE IF AT END OF WLOOP YET
	XCHG	BX,DX
	MOV	BX,Word Ptr LISTEND
	CALL	CMPDEHL			;COMPARE
	JZ	L_16	
	JMP	WLOOP			;GO ON TO NEXT POSITION TO PRINT
L_16:
;
;
;AT END OF DIRECTORY. PRINT MESSAGE AND GO BACK TO TOP
;
	CALL	PRTMSG			;PRINT END OF DIRECTORY MESSAGE
	DB	CR,LF,'      End of List',CR,LF,CR,LF,0
	MOV	BX,(Offset FNLIST)	;SET POSITION POINTER TO BEGINNING
	MOV	Word Ptr LISTPOS,BX
	JMP	WLOOP			;TO REDISPLAY START ENTRY
;
;
;CLEAN COMMAND WLOOP EXIT POINT TO CP/M
;
EXIT:
	MOV	CL,0			;BACK TO CP/M
	MOV	DL,0
	INT	224
;
;
;ROUTINE TO RENAME THE FILE CURRENTLY DISPLAYED
;
RENAME:
	MOV	BX,Word Ptr LISTPOS	;MOVE NAME FROM FNLIST TO RENAME FCB
	MOV	DX,12
	CALL	SDEHL			;POINT TO NAME POSITION
	MOV	DX,(Offset DESTFCB)	;PLACE TO MOVE THE NAME
	MOV	CH,12			;AMOUNT TO MOVE
	CALL	MOVBYT
;
	CALL	PRTMSG			;NEW NAME PROMPT
	DB	'  New Name ? ',0
	MOV	CL,GETBUF		;GET COMMAND BUFFER FUNCTION
	MOV	DX,(Offset CBUFF)	;PLACE TO PUT COMMAND LINE
	INT	224
;
;
;CONVERT TO UPPER CASE
;
	MOV	BX,(Offset CBUFFL)	;GET BUFFER LENGTH
	MOV	CH,M			;..TO (B)
	XOR	AL,AL
	OR	AL,CH			;IF ZERO LENGTH SKIP RENAME
	JZ	NEXTPOS
;
CONV:
	INC	BX			;POINT AT A CHAR TO CONVERT
	MOV	AL,M
	CALL	UPCASE
	MOV	M,AL			;PUT BACK INTO BUFFER
	DEC	CH
	JNZ	CONV
;
;
;SCAN INPUT BUFFER TO MOVE A FILE NAME TO THE RENAME POSITION OF
;DESTINATION FCB
;
	MOV	BX,(Offset DESTFCB)+16
	MOV	M,0			;BDOS EXPECTS ZERO HERE
	INC	BX
;
;
;PREBLANK THE NEW FILE NAME FIELD
;
	PUSH	BX			;SAVE START POINTER
	MOV	CH,11			;NUMBER OF SPACES TO BLANK
PREFILL:
	MOV	M,' '			;PUT IN A SPACE CODE
	INC	BX
	DEC	CH			;CHECK BYTE COUNT TO SEE IF DONE
	JNZ	PREFILL
	POP	BX
;
	XCHG	BX,DX
	MOV	BX,(Offset CBUFFL)	;GET LENGTH TO (C)
	MOV	CL,M
	INC	BX
	XCHG	BX,DX			;(DE) = BUFFER POINTER
;..& (HL) = FCB POINTER
;
;
;PURGE SPACES OFF THE BEGINNING OF BUFFER
;
DEBLANK:
	MOV	SI,DX			;GET A CHARACTER
	MOV	AL,[SI]
	CMP	AL,' '
	JNZ	EXTND			;NOT BLANK, WE HAVE SOMETHING
	LAHF				;TO NEXT CHAR
	INC	DX
	SAHF
	DEC	CL
	JNZ	L_17	
	JMP	CMDERR			;ALL SPACES SO ERROR
L_17:
	JMPS	DEBLANK
;
;
;EXTEND BUFFER TO BLANKS BEYOND COMMAND LENGTH
;
EXTND:
	PUSH	BX
	MOV	BL,CL			;DOUBLE BYTE REMAINING LENGTH
	MOV	BH,0
	LAHF				;TO BUFFER END +1
	ADD	BX,DX
	RCR	SI,1
	SAHF
	RCL	SI,1
	MOV	M,' '			;FORCE ILLEGAL CHAR END
	POP	BX
;
;
;START FILE NAME SCAN
;
SCAN:
	MOV	CH,8			;MAX OF 8 CHAR IN FILE NAME
SCAN1:
	CALL	CHKLEGL			;GET AND SEE IF LEGAL CHARACTER
	JNB	L_18	
	JMP	CMDERR			;CHECK IF ALL OF COMMAND LINE
L_18:
	CMP	AL,' '			;SEE IF END OF PARAMETER FIELD
	JZ	CPYBITS			;GO TO RENAME THE FILE
	CMP	AL,'.'			;AT END OF FILE NAME
	JZ	SCAN2			;GO TO PROCESS THE FILE TYPE FIELD
	MOV	M,AL			;PUT CHAR INTO DESTINATION FCB
	LAHF
	INC	BX
	SAHF
	DEC	CH			;CHECK NAME CHARACTER COUNT
	JNZ	SCAN1
;
;
;GOT HERE IF EIGHT CHAR WITHOUT A "."
;
SCAN1A:
	CALL	CHKLEGL			;SCAN BUFFER UP TO PERIOD
;OR END
	JB	CPYBITS			;NO EXTENT IF NOT LEGAL
	CMP	AL,' '			;END OF PARAMETER FIELD?
	JZ	CPYBITS
	CMP	AL,'.'
	JZ	SCAN2			;NOW GO DO EXTENT FIELD
	JMPS	SCAN1A			;DO TILL END OR PERIOD
;
;
;NOW BUILD THE EXTENT FIELD
;
SCAN2:
	MOV	CH,3			;MAX LENGTH OF EXTENT FIELD
	MOV	BX,(Offset DESTFCB)+25	;DESTINATION RENAME EXTENT START
SCAN3:
	CALL	CHKLEGL			;GET AND CHECK CHARACTER
	JB	SCAN4			;NAME DONE IF ILLEGAL
	CMP	AL,' '			;END OF PARAMETER FIELD?
	JZ	SCAN4
	CMP	AL,'.'			;CHECK IF ANOTHER PERIOD
	JZ	SCAN4
	MOV	M,AL
	INC	BX
	DEC	CH
	JNZ	SCAN3			;GET NEXT EXTENT CHARACTER
;
SCAN4:
	MOV	CH,4			;FILL EX,S1,S2,RC WITH ZEROS
	MOV	BX,(Offset DESTFCB)+28	;SET POINTER TO RENAME EXTENT FIELD
SCAN5:
	MOV	M,0
	INC	BX
	DEC	CH
	JNZ	SCAN5
;
;
;COPY OLD FILES ATTRIBUTE BITS TO THE NEW FILE NAME TO HAVE THEN BE
;THE SAME AS OLD FILE NAME
;
CPYBITS:
	MOV	DX,(Offset DESTFCB)+1	;FIRST CHAR OF OLD NAME
	MOV	BX,(Offset DESTFCB)+17	;FIRST CHAR OF NEW NAME
	MOV	CL,011			;NUMBER OF BYTES WITH TAG BITS
CBITS1:
	MOV	SI,DX			;FETCH BIT OF OLD NAME CHAR
	MOV	AL,[SI]
	AND	AL,080H			;STRIP ONLY UPPER BIT OUT
	MOV	CH,AL			;SAVE BIT INTO (B)
	MOV	AL,07FH			;FETCH A MASK FOR CHAR ONLY
	AND	AL,M			;GET MASKED CHAR TO (A)
	OR	AL,CH			;PUT OLD BIT IN
	MOV	M,AL			;SAVE NEW BYTE BACK
	INC	BX			;BUMP COPY POINTERS
	INC	DX
	DEC	CL			;DEC BYTE COPY COUNT
	JNZ	CBITS1
;
;
;SEE IF THE NEW FILE NAME ALREADY EXISTS. IF SO SAY SO AND THEN GO
;TO THE COMMAND WLOOP AGAIN AT SAME POSITION
;
	MOV	AL,Byte Ptr DESTFCB	;COPY NEW NAME TO SOURCE FCB
	MOV	Byte Ptr SORCFCB,AL
	MOV	CH,11
	MOV	BX,(Offset DESTFCB)+17	;COPY NEW NAME TO
	MOV	DX,(Offset SORCFCB)+1	;..SOURCE FCB FOR EXISTENCE CHECK
	CALL	MOVBYT
	MOV	CH,4			;ZERO THE OPERATIONAL FIELDS
	MOV	BX,(Offset SORCFCB)+12
RNFILLP:
	MOV	M,0			;PUT A ZERO IN THERE
	INC	BX			;TAKE CARE OF COUNTERS
	DEC	CH
	JNZ	RNFILLP
;
	MOV	DX,(Offset SORCFCB)	;SEARCH TO SEE IF THIS FILE EXISTS
	MOV	CL,SRCHF		;SEARCH FIRST FUNCTION
	INT	224
	CMP	AL,0FFH			;RETURN CODE IF NOT FOUND
	JZ	RNFILE			;TO RENAME COMMAND IF NOT A DUPLICATE NAME
;
	CALL	PRTMSG			;ASK IF TO REPLACE
	DB	CR,LF,' ++ Name Already Exists ++',CR,LF,0
	JMP	SAMEPOS			;BACK TO LET HIM TRY ALL THAT AGAIN ON
;... THE SAME FILE NAME
;
;
;COPY NEW NAME INTO FNLIST POSITION IN CASE HE BACKS UP
;
RNFILE:
	MOV	BX,Word Ptr LISTPOS	;GET FNLIST POSITION POINTER
	MOV	DX,11			;BACK 11 TO LEAVE DRIVE ID THE SAME
	CALL	SDEHL
	XCHG	BX,DX
	MOV	BX,(Offset DESTFCB)+17	;POINT AT THE NEW NAME
	MOV	CH,11			;AMOUNT TO MOVE
	CALL	MOVBYT
;
;
;NOW DO THE RENAME BDOS FUNCTION
;
RNFIL1:
	MOV	DX,(Offset DESTFCB)	;RENAME FCB LOCATION
	MOV	CL,RENAM		;RENAME FUNCTION CODE
	INT	224			;GO DO IT
	CMP	AL,0FFH			;SEE IF RENAME ERROR
	JZ	L_19	
	JMP	NEXTPOS			;IF O.K. PROCEDE
L_19:
	CALL	PRTMSG			;OR ELSE PRINT ERROR MESSAGE
	DB	' ++ Not Found ++',0
	JMP	NEXTPOS			;GO TO NEXT FNLIST POSITION
;
;
;DELETE A FILE NAME AS SPECIFIED IN CURRENT POSITION POINTER
;
DELFLE:
	MOV	BX,Word Ptr LISTPOS	;MOVE NAME FROM FNLIST TO RENAME FCB
	MOV	DX,12
	CALL	SDEHL			;POINT TO NAME POSITION
	MOV	DX,(Offset DESTFCB)	;PLACE TO MOVE THE NAME
	MOV	CH,12			;AMOUNT TO MOVE
	CALL	MOVBYT
;
;
;DELETE THE FILE NOW
;
	MOV	DX,(Offset DESTFCB)	;POINT AT DELETE FCB
	MOV	CL,DELETE		;DELETE FUNCTION CODE
	INT	224
;AVOID 1.4 BUG
	CMP	AL,0FFH
	JNZ	DELFL1			;FILE DELETED O.K.
	CALL	PRTMSG			;TYPE ERROR MESSAGE
	DB	' ++ Not Found ++',0
	JMP	NEXTPOS
;
DELFL1:
	CALL	PRTMSG			;SAY IT HAS BEEN DELETED
	DB	'  Deleted',0
;
;
;MOVE FNLIST UP ONE POSITION TO CLOSE UP THE ERASED POSITION
;
	MOV	BX,Word Ptr LISTPOS	;FIXUP MOVE UP POINTERS
	PUSH	BX
	MOV	DX,12
	CALL	SDEHL
	MOV	Word Ptr LISTPOS,BX	;RESET CURRENT POSITION FOR MOVE
	XCHG	BX,DX			;(DE) = TO LOCATION
	POP	BX			;(HL) = FROM LOCATION
;
MOVUP:
	XCHG	BX,DX
	PUSH	BX			;CHECK IF AT END
	MOV	BX,Word Ptr LISTEND	;GET OLD END POINTER
	CALL	CMPDEHL			;CHECK AGAINST CURRENT END LOCATION
	POP	BX
	XCHG	BX,DX
	JZ	MOVDONE			;MUST BE AT END OF FNLIST
	MOV	CH,12			;ONE NAME SIZE
	CALL	MOVBYT			;MOVE ONE NAME UP
	JMPS	MOVUP			;GO CHECK END PARAMETERS
;
MOVDONE:
	XCHG	BX,DX
	MOV	Word Ptr LISTEND,BX	;SET NEW FNLIST END IF ALL MOVED
	MOV	DX,(Offset FNLIST)	;SEE IF FNLIST IS EMPTY
	CALL	CMPDEHL			;..IE LISTEND=LISTPOS=FNLIST
	JZ	L_20	
	JMP	NEXTPOS
L_20:
	MOV	BX,Word Ptr LISTPOS
	CALL	CMPDEHL
	JZ	L_21	
	JMP	NEXTPOS			;NEITHER EQUAL SO NOT EMPTY
L_21:
	CALL	PRTMSG
	DB	CR,LF,CR,LF,'      List Empty',0
	JMP	EXIT			;BALE OUT IF DONE
;
;
;ENTRY POINT TO SEND CURRENT FILE NAME CONTENTS TO THE CONSOLE
;
VIEW:
	CALL	PRTMSG
	DB	CR,LF,CR,LF,0		;TURN UP TWO NEW LINES
	MOV	AL,WRCON		;WRITE CONSOLE OUT FUNCTION
	JMPS	OUTCM			;TO COMMON I/O PROCESSING
;
;
;ENTRY POINT TO SEND CURRENT FILE NAME CONTENTS TO THE FNLIST DEVICE
;
PRTFIL:
	MOV	AL,WRLST		;WRITE FNLIST DEVICE OUT FUNCTION
	JMPS	OUTCM			;TO COMMON I/O PROCESSING
;
;
;ENTRY POINT TO SEND CURRENT FILE NAME CONTENTS TO THE PUNCH DEVICE
;
PUNFIL:
	MOV	AL,WRPUN		;WRITE PUNCH DEVICE OUT FUNCTION
;
;
;COMMON OUTPUT CHARACTER I/O PROCESSING ENTRY
;
OUTCM:
	MOV	Byte Ptr OUTOP,AL	;SAVE BDOS FUNCTION
;
;
;FETCH THE FILE NAME TO SEND OUT
;
	MOV	BX,Word Ptr LISTPOS	;MOVE NAME FROM FNLIST TO SOURCE FCB
	MOV	DX,12
	CALL	SDEHL			;POINT TO NAME POSITION
	MOV	DX,(Offset SORCFCB)	;PLACE TO MOVE THE NAME
	MOV	CH,12			;AMOUNT TO MOVE
	CALL	MOVBYT
;
	MOV	DX,BUFR			;SET TO USE DEFAULT DMA BUFFER
	MOV	CL,STDMA		;ADDRESS SET FUNCTION
	INT	224
;
	MOV	CH,4			;FILL EX,S1,S2,RC WITH ZEROS
	MOV	BX,(Offset SORCFCB)+12	;SET POINTER TO SOURCE EXTENT FIELD
OUTCM1:
	MOV	M,0
	INC	BX
	DEC	CH
	JNZ	OUTCM1
;
	MOV	DX,(Offset SORCFCB)	;OPEN THE FILE FOR READING
	MOV	CL,OPEN			;FILE OPEN FUNCTION CODE
	INT	224
	CMP	AL,0FFH
	JNZ	OUTCM2			;SKIP ERROR MESSAGE IF O.K.
	CALL	PRTMSG
	DB	' ++ File Cannot Be Opened ++',0
	JMP	NEXTPOS
;
OUTCM2:
	XOR	AL,AL			;ZERO THE CURRENT RECORD FIELD
	MOV	Byte Ptr SORCFCB+32,AL
;
OUTCM3:
	MOV	DX,(Offset SORCFCB)	;POINT AT FILE FCB FOR READING
	MOV	CL,READR		;FUNCTION SET FOR RECORD READ
	INT	224
	OR	AL,AL			;CHECK IF READ WAS O.K.
	JZ	OUTCM4			;READ O.K. SO GO TO SEND OUT
	JMP	NEXTPOS			;EOF SO TO NEXT FNLIST NAME POSITION
;
OUTCM4:
	MOV	BX,BUFR			;POINT AT SECTOR JUST READ
	MOV	CH,080H			;SET SECTOR CHARACTER COUNTER TO OUTPUT
OUTCM5:
	MOV	AL,M			;GET A CHARACTER
	CMP	AL,01AH			;SEE IF LOGICAL END OF FILE
	JNZ	L_22	
	JMP	NEXTPOS			;BACK TO FNLIST WLOOP IF LOG EOF
L_22:
	MOV	DL,AL			;POSITION CHARACTER FOR BDOS
	PUSH	CX
	PUSH	BX
	MOV	AL,Byte Ptr OUTOP	;GET DEVICE CODE FOR OUTPUT
	MOV	CL,AL
	INT	224			;SEND THE CHARACTER
;
	MOV	CL,GETST		;GET CONSOLE STATUS FUNCTION
	INT	224			;GO GET THE ABORT STATUS
	POP	BX
	POP	CX
;
	OR	AL,AL			;IF CHAR THERE, THEN ABORT
	JZ	L_23	
	JMP	BACKUP			;  TO SAME FNLIST POSITION
L_23:
;
	INC	BX			;INC BUFFER POINTER
	DEC	CH			;ALL BYTES OF SECTOR SENT YET?
	JNZ	OUTCM5			;MORE TO DO
;
	JMPS	OUTCM3			;GO GET THE NEXT SECTOR
;
;
;ROUTINE TO COPY A DISK FILE NAMED BY THE CURRENT FNLIST POSITON TO
;A DIFFERENT DISK DRIVE OF OPERATOR SELECTION.
;
COPY:
	MOV	BX,Word Ptr LISTPOS	;MOVE NAME FROM FNLIST TO SOURCE FCB
	MOV	DX,12
	CALL	SDEHL			;POINT TO NAME POSITION
	MOV	DX,(Offset SORCFCB)	;PLACE TO MOVE THE NAME
	MOV	CH,12			;AMOUNT TO MOVE
	CALL	MOVBYT
;
	MOV	CH,4			;FILL EX,S1,S2,RC WITH ZEROS
	MOV	BX,(Offset SORCFCB)+12	;SET POINTER TO SOURCE EXTENT FIELD
COPY1:
	MOV	M,0			;PUT ZERO IN
	INC	BX
	DEC	CH
	JNZ	COPY1
;
	XOR	AL,AL			;ZERO THE CURRENT RECORD FIELD
	MOV	Byte Ptr SORCFCB+32,AL
;
	MOV	CH,33			;COPY SOURCE FCB TO DESTINATION FCB
	MOV	BX,(Offset SORCFCB)	;FROM COPY POINT
	MOV	DX,(Offset DESTFCB)	;TO COPY POINT
	CALL	MOVBYT			;MOVE IT ACROSS
;
	MOV	DX,(Offset SORCFCB)	;OPEN THE FILE FOR READING
	MOV	CL,OPEN			;FILE OPEN FUNCTION CODE
	INT	224
	CMP	AL,0FFH
	JNZ	COPY2			;SKIP ERROR MESSAGE IF O.K.
	CALL	PRTMSG
	DB	CR,LF,' ++ Source File Cannot Be Opened ++',0
	JMP	NEXTPOS
;
COPY2:
	CALL	PRTMSG			;PROMPT FOR DRIVE SELECT NAME
	DB	'  Destination Drive ? ',0
	MOV	CL,KEYIN		;GET SELECTION
	INT	224
	CALL	UPCASE			;CONVERT TO UPPER CASE
	SUB	AL,'A'			;ZERO BASE FOR RANGE CHECK
	CMP	AL,'P'-'A'+1
	JNAE	L_24	
	JMP	CMDERR			;BACK TO COMMAND WLOOP WITH "?"
L_24:
;
	INC	AL			;BASE DRIVE SELECT FOR 1=A:
	MOV	Byte Ptr DESTFCB,AL	;SET INTO THE DESTINATION FCB
;
	MOV	CH,AL			;SEE IF HE PICKED SAME DISK AS CURRENT
	MOV	AL,Byte Ptr SORCFCB	;GET SOURCE DRIVE ID
	CMP	AL,CH
	JNZ	COPY2A			;NO THEY ARE DIFFERENT?
	CALL	PRTMSG
	DB	CR,LF,' ++ Cannot Select Same Disk as Source ++',CR,LF,0
	JMP	SAMEPOS			;LET HIM TRY AGAIN
;
COPY2A:
	MOV	DX,(Offset DESTFCB)	;SEARCH TO SEE IF THIS FILE EXISTED
	MOV	CL,SRCHF		;SEARCH FIRST FUNCTION
	INT	224
	CMP	AL,0FFH			;RETURN CODE IF NOT FOUND
	JZ	COPY3			;GO TO MAKE FUNCTION FOR NEW FILE
;
	CALL	PRTMSG			;ASK IF TO REPLACE
	DB	'  Replace ? ',0
	MOV	CL,KEYIN		;GET HIS ANSWER
	INT	224
	CALL	UPCASE
	CMP	AL,'Y'			;IF YES THEN DELETE IT AND COPY OVER
	JZ	L_25	
	JMP	NEXTPOS			;IF COPY NOT WANTED THEN ON TO NEXT
L_25:
;
	MOV	DX,(Offset DESTFCB)	;DELETE FILE THAT ALREADY EXISTS
	MOV	CL,DELETE		;ERASE FILE FUNCTION CODE
	INT	224
;
COPY3:
	MOV	DX,(Offset DESTFCB)	;MAKE NEW FILE AND OPEN FOR WRITING
	MOV	CL,MAKE			;MAKE FUNCTION CODE
	INT	224			;GO MAKE IT
	CMP	AL,0FFH			;CHECK IF THE DIRECTORY WAS FULL
	JNZ	COPY4
	CALL	PRTMSG
	DB	CR,LF,' ++ Destination Directory Full ++',0
	JMP	NEXTPOS			;BACK TO FNLIST PROCESSOR IF ERROR
;
COPY4:
	MOV	CX,0			;FIGURE OUT HOW MANY SECTORS
	MOV	BX,Word Ptr .BDOS+1	;FIT INTO MEMORY BUFFER
	DEC	BX
	XCHG	BX,DX			;(DE) = MAX ADDRESS ALLOWABLE
	MOV	BX,Word Ptr BUFSTART	;START ADDRESS OF BUFFER
COPY5:
	INC	CX			;INCREASE SECTOR COUNT BY ONE
	PUSH	DX
	MOV	DX,080H			;ONE SECTOR SIZE
	ADD	BX,DX			;BUFFER ADDRESS + SEC SIZE
	POP	DX
	CALL	CMPDEHL			;COMPARE VALUES TO SEE IF ALL DONE
	JNB	COPY5			;MORE WILL FIT?
;
	DEC	CX			;SET MAX SECTOR COUNT LESS BY ONE
	MOV	AL,CH			;CHECK IF ANY MEMORY FOR COPY AT ALL
	OR	AL,CL
	JNZ	COPY6			;THERE IS MEMORY FOR BUFFER
	CALL	PRTMSG
	DB	CR,LF,' ++ No Memory Available for Copy Buffer ++',0
	JMP	NEXTPOS
;
COPY6:
	MOV	BL,CL
	MOV	BH,CH			;PUT MAX SECTOR COUNT IN STORAGE
	MOV	Word Ptr BUFMAX,BX
	XOR	AL,AL			;CLEAR EOF FLAG
	MOV	Byte Ptr EOFLG,AL
;
COPY6A:
	MOV	BX,0			;SET CURRENT BUFFER COUNTER TO ZERO
	MOV	Word Ptr BUFCNT,BX
	MOV	BX,Word Ptr BUFSTART	;SET BUFFER START POINTER TO BEGIN
	MOV	Word Ptr BUFPNT,BX
;
;
;FILE SOURCE READING WLOOP TO READ ALL MEMORY FULL OR STOP ON EOF
;
COPY7:
	MOV	BX,Word Ptr BUFPNT	;SET DMA ADDRESS TO BUFFER POINTER
	XCHG	BX,DX
	MOV	CL,STDMA
	INT	224
;
	MOV	DX,(Offset SORCFCB)	;POINT AT FILE FCB FOR READING
	MOV	CL,READR		;FUNCTION SET FOR RECORD READ
	INT	224
	OR	AL,AL			;CHECK IF READ WAS O.K. OF EOF
	JNZ	COPY8			;END OF FILE SO SET EOF FLAG
;
	MOV	BX,Word Ptr BUFPNT	;SET BUFFER POINTER UP ONE SECTOR
	MOV	DX,080H
	LAHF
	ADD	BX,DX
	SAHF
	MOV	Word Ptr BUFPNT,BX
	MOV	BX,Word Ptr BUFCNT	;INCREASE BUFFER SECTOR COUNT
	LAHF
	INC	BX
	SAHF
	MOV	Word Ptr BUFCNT,BX
	XCHG	BX,DX			;CHECK TO SEE IF MEMORY IS FULL
	MOV	BX,Word Ptr BUFMAX	;MAXIMUM SECTOR COUNT
	CALL	CMPDEHL			;COMPARE
	JNZ	COPY7			;IF NOT FULL GO GET NEXT SECTOR
	JMPS	COPY9			;GO HANDLE WRITE OPERATION
;
;
;HERE IF READ OPERATION INDICATES THAT THE FILE IS AT ITS END ON READ
;
COPY8:
	MOV	AL,0FFH			;SET EOF FLAG
	MOV	Byte Ptr EOFLG,AL
;
;
;WRITE OUTPUT FILE PROCESSING WLOOP TO SEND MEMORY BUFFER TO
;DESTINATION DISK FILE
;
COPY9:
	MOV	BX,Word Ptr BUFSTART	;SET BUFFER POINTER TO START
	MOV	Word Ptr BUFPNT,BX
;
COPY10:
	MOV	BX,Word Ptr BUFCNT	;SEE IF BUFFER IS EMPTY YET
	MOV	AL,BH
	OR	AL,BL
	JZ	COPY11			;BUFFER EMPTY SO CHECK EOF FLAG
	DEC	BX			;DEC BUFFER SECTOR COUNT FOR EACH WRITE
	MOV	Word Ptr BUFCNT,BX
;
	MOV	BX,Word Ptr BUFPNT	;SET UP DMA ADDRESS
	PUSH	BX			;SAVE FOR SIZE BUMP
	XCHG	BX,DX
	MOV	CL,STDMA
	INT	224
	POP	BX
	MOV	DX,080H			;INCREASE ADDRESS FOR SECTOR SIZE
	ADD	BX,DX
	MOV	Word Ptr BUFPNT,BX
;
	MOV	DX,(Offset DESTFCB)	;POINT TO OUTPUT FILE FCB
	MOV	CL,WRITER		;WRITE RECORD FUNCTION CODE
	INT	224			;GO WRITE
	OR	AL,AL			;CHECK IF ANY ERROR-CAF
	JZ	COPY10			;O.K. SO DO NEXT RECORD
;
	CALL	PRTMSG			;TELL OF DISK WRITE ERROR
	DB	CR,LF,' ++ Disk or Directory Full or error on Write ++',0	;ts
	JMP	NEXTPOS			;BACK TO FNLIST PROCESSING
;
COPY11:
	MOV	AL,Byte Ptr EOFLG	;BUFFER ALL WRITTEN SO GO CHECK EOF
	OR	AL,AL
	JNZ	L_26	
	JMP	COPY6A			;GO TO READ NEXT BUFFER FULL
L_26:
;
	MOV	DX,(Offset DESTFCB)	;POINT AT FCB FOR FILE CLOSE
	MOV	CL,CLOSE		;CLOSE FILE FUNCTION CODE
	INT	224
	CMP	AL,0FFH			;CHECK IF CLOSE ERROR
	JZ	L_27	
	JMP	NEXTPOS
L_27:
	CALL	PRTMSG
	DB	CR,LF,' ++ Destination Close Error ++',0
	JMP	NEXTPOS
;
;
;ROUTINE TO INQUIRE ABOUT SELECTING OPERATION ON ANOTHER DRIVE
;
LOG:
	CALL	PRTMSG			;PROMPT FOR DRIVE SELECT NAME
	DB	'  New Drive ? ',0
	MOV	CL,KEYIN		;GET SELECTION
	INT	224
	CALL	UPCASE			;CONVERT TO UPPER CASE
	CMP	AL,CR			;IF CARRIAGE RETURN SKIP RE-LOG
	JNZ	L_28	
	JMP	NEXTPOS
L_28:
;
	SUB	AL,'A'			;ZERO BASE FOR RANGE CHECK
	CMP	AL,'P'-'A'+1
	JNAE	L_29	
	JMP	CMDERR			;BACK TO COMMAND WLOOP WITH "?"
L_29:
;
	INC	AL			;BASE DRIVE SELECT FOR 1=A:
	MOV	Byte Ptr .FCB,AL	;SET INTO THE START DEFAULT FCB
	MOV	AL,' '			;SET DEFAULT FCB TO LOOK LIKE *.*
	MOV	Byte Ptr .FCB+1,AL
	MOV	Byte Ptr .FCB+9,AL
;
; DISK RESET ROUTINE	(Vers. 1.5 Simon Ewins)
;
	MOV	CL,0DH			;CALL BDOS RESET
	INT	224
;
	JMP	RESTART			;GO RESTART WITH MENU PRINT OVER
;
;
;
;***************************************************************************
;
;	UTILITY SUBROUTINES
;
;COMPARE DOUBLE REGISTERS (DE) TO (HL) SIMILAR TO CMP B INSTRUCTION AND SET
;FLAGS ACCORDINGLY.
;
CMPDEHL:
	MOV	AL,DH			;SEE IF HIGH BYTES SET FLAGS
	CMP	AL,BH
	JZ	L_30	
	RET				;RETURN IF NOT EQUAL
L_30:
	MOV	AL,DL
	CMP	AL,BL			;LOW BYTES SET THE FLAGS INSTEAD
	RET
;
;
;SUBTRACT DOUBLE REGISTERS (DE) FROM (HL) LEAVING RESULT IN (HL)
;
SDEHL:
	MOV	AL,BL			;DO LOW BYTES FIRST
	SUB	AL,DL
	MOV	BL,AL			;SET LOW BYTE OF RESULT BACK
	MOV	AL,BH			;HIGH BYTES NOW
	SBB	AL,DH			;SUBTRACT HIGH AND BORROW
	MOV	BH,AL			;HIGH BYTE OF RESULT BCK TO (H)
	RET
;
;
;MOVE SUBROUTINE  MOVE (B) BYTES FROM (HL) TO (DE)
;
MOVBYT:
	MOV	AL,M			;GET (HL) REFERENCED SOURCE BYTE
	AND	AL,7FH			;STRIP CP/M 2.x ATTRIBUTES
	MOV	SI,DX			;PUT TO (DE) REFERENCED DESTINATION
	MOV	[SI],AL
	LAHF				;FIX POINTERS FOR NEXT SEARCH
	INC	BX
	SAHF
	LAHF
	INC	DX
	SAHF
	DEC	CH			;DEC BYTE COUNT AND SEE IF DONE
	JNZ	MOVBYT
	RET
;
;
;INLINE PRINT OF MESSAGE TILL A ZERO
;
PRTMSG:
	MOV	BP,SP			;SAVE HL, GET MSG POINTER
	XCHG	BX,[BP]
;
PRTMLP:
	MOV	AL,M			;GET CHARACTER
	AND	AL,07FH			;STRIP USER TYPE BITS
	MOV	DL,AL
	LAHF				;INCREMENT POINTER TO NEXT CHAR
	INC	BX
	SAHF
;..OR RETURN ADDRESS
	JZ	PMXIT			;EXIT IF ZERO
;
	PUSH	BX			;SAVE MESSAGE POINTER
	MOV	CL,WRCON		;CHARACTER OUTPUT FUNCTION CODE
	INT	224			;OUTPUT IT
	POP	BX
	JMPS	PRTMLP			;GO CHECK/DO NEXT CHAR
;
PMXIT:
	MOV	BP,SP			;RESTORE HL, RET ADDR
	XCHG	BX,[BP]
	RET				;RET PAST MSG
;
;
;CONVERT CHARACTER IN (A) TO UPPER CASE
;
UPCASE:
	AND	AL,07FH			;STRIP UPPER BIT
	CMP	AL,060H			;IS CHAR ONE REQUIRING CONVERT
	JNB	L_31	
	RET				;NO CONVERT NEEDED
L_31:
	AND	AL,05FH			;CONVERT
	RET
;
;
;CHECK FOR LEGAL FILE NAME CHARACTER
;
CHKLEGL:
	MOV	SI,DX			;GET CHARACTER FROM .(DE)
	MOV	AL,[SI]
	INC	DX			;TO POINT AT NEXT CHARACTER
	CMP	AL,' '			;IS IT LESS THAN SPACE
	JNB	L_32	
	RET				;RETURN CARRY IF ERROR CHAR
L_32:
	CMP	AL,05FH			;IF GREATER THAN UNDERSCORE ERROR
	JNB	CHKERR			;CARRY SET EXIT
	CMP	AL,'='
	JZ	CHKERR
	CMP	AL,':'
	JZ	CHKERR
	CMP	AL,';'
	JZ	CHKERR
	CMP	AL,'<'
	JZ	CHKERR
	CMP	AL,'>'
	JZ	CHKERR
	OR	AL,AL			;CLEAR CARRY FOR GOOD CHAR
	RET
;
CHKERR:
	STC				;ERROR EXIT
	RET
;
;
;ROUTINE TO COMPARE TWO STRINGS LEFT TO RIGHT SIMILAR TO CMP B INSTRUCTION
;
;	(B)=STRING LENGTH
;	(DE)=STRING A BASE POINTER
;	(HL)=STRING B BASE POINTER
;
CMPSTR:
	MOV	SI,DX			;GET AN A STRING CHARACTER
	MOV	AL,[SI]
	CMP	AL,M			;CHECK AGAINST B STRING CHARACTER
	JZ	L_33	
	RET				;NOT EQUAL SETS RETURN FLAGS
L_33:
	DEC	CH			;DECREMENT COMPARE BYTE COUNT
	JNZ	L_34	
	RET				;SET LIKE EQUAL IF ALL COMPARED EQUAL
L_34:
	INC	BX			;BUMP COMPARE POINTERS
	INC	DX
	JMPS	CMPSTR			;TO DO NEXT CHARACTER
;
;
;ROUTINE TO INTERCHANGE TWO STRINGS FOR SORTING
;
;	(B)=STRING LENGTH
;	(DE)=STRING A BASE POINTER
;	(HL)=STRING B BASE POINTER
;
SWAP:
	MOV	CL,M			;GET CHAR FROM ONE STRING
	MOV	SI,DX			;AND ONE FROM OTHER STRING
	MOV	AL,[SI]
	MOV	M,AL			;SECOND INTO FIRST
	MOV	AL,CL			;FIRST INTO SECOND
	MOV	SI,DX
	MOV	[SI],AL
	LAHF				;BUMP SWAP POINTERS
	INC	BX
	SAHF
	LAHF
	INC	DX
	SAHF
	DEC	CH			;SEE IF ALL BYTES SWAPPED YET
	JNZ	SWAP
	RET
L_35	EQU	$
	DSEG
	ORG	Offset L_35
;
;
;*************************************************************************
;
;
;
	RS	0200H			;DEFINE STORAGE FOR AN EXECUTION STACK (512 bytes)
STCKK	RS	0
	RS	2
;
SORCFCB	RS	0
	RS	33			;FCB FOR SOURCE FILE
;
DESTFCB	RS	0
	RS	33			;FCB FOR DESTINATION FILE IF COPY
;AND NEW NAME IF RENAME FUNCTION
;
MAXLEN	EQU	25			;MAXIMUM BUFFER INPUT LENGTH
;
CBUFF	RS	0
	DB	MAXLEN			;COMMAND BUFFER LENGTH
CBUFFL	RS	0
	DB	0			;CURRENT INPUT LENGTH
CSTRING	RS	0
	RS	MAXLEN+3		;STORAGE FOR INPUT
;
LISTPOS	RS	0
	RS	2			;CURRENT FNLIST POSITION IN SCAN
;
LISTI	RS	0
	RS	2			;FNLIST SORT POINTER
;
LISTJ	RS	0
	RS	2			;ANOTHER FNLIST SORT POINTER
;
LISTEND	RS	0
	RS	2			;CURRENT FNLIST END POINTER
;
BUFSTART	RS	0
	RS	2			;START POINTER FOR COPY BUFFER
;
BUFPNT	RS	0
	RS	2			;CURRENT POINTER FOR COPY BUFFER
;
BUFMAX	RS	0
	RS	2			;MAXIMUM NUMBER OF BUFFER SECTORS
;
BUFCNT	RS	0
	RS	2			;NUMBER OF SECTORS CURRENTLY IN BUFFER
;
OUTOP	RS	0
	RS	1			;SIMPLE FILE OUTPUT DESTINATION FUNCTION
;EQUAL TO BDOS FLAG
;
EOFLG	RS	0
	RS	1			;FILE COPY WLOOP EOF FLAG
;
FNLIST	RS	0
	RS	1			;BASE OF FILE NAME FNLIST
;
;
;
	END
