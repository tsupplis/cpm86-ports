CMPDEHL:
	MOV	AL,DH			;SEE IF HIGH BYTES SET FLAGS
	CMP	AL,BH
	JZ	L_30	
	RET				;RETURN IF NOT EQUAL
L_30:
	MOV	AL,DL
	CMP	AL,BL			;LOW BYTES SET THE FLAGS INSTEAD
	RET
;
;
;SUBTRACT DOUBLE REGISTERS (DE) FROM (HL) LEAVING RESULT IN (HL)
;
SDEHL:
	MOV	AL,BL			;DO LOW BYTES FIRST
	SUB	AL,DL
	MOV	BL,AL			;SET LOW BYTE OF RESULT BACK
	MOV	AL,BH			;HIGH BYTES NOW
	SBB	AL,DH			;SUBTRACT HIGH AND BORROW
	MOV	BH,AL			;HIGH BYTE OF RESULT BCK TO (H)
	RET
;
;
;MOVE SUBROUTINE  MOVE (B) BYTES FROM (HL) TO (DE)
;
MOVBYT:
	MOV	AL,M			;GET (HL) REFERENCED SOURCE BYTE
	AND	AL,7FH			;STRIP CP/M 2.x ATTRIBUTES
	MOV	SI,DX			;PUT TO (DE) REFERENCED DESTINATION
	MOV	[SI],AL
	LAHF				;FIX POINTERS FOR NEXT SEARCH
	INC	BX
	SAHF
	LAHF
	INC	DX
	SAHF
	DEC	CH			;DEC BYTE COUNT AND SEE IF DONE
	JNZ	MOVBYT
	RET
;
;
;INLINE PRINT OF MESSAGE TILL A ZERO
;
PRTMSG:
	MOV	BP,SP			;SAVE HL, GET MSG POINTER
	XCHG	BX,[BP]
;
PRTMLP:
	MOV	AL,M			;GET CHARACTER
	AND	AL,07FH			;STRIP USER TYPE BITS
	MOV	DL,AL
	LAHF				;INCREMENT POINTER TO NEXT CHAR
	INC	BX
	SAHF
;..OR RETURN ADDRESS
	JZ	PMXIT			;EXIT IF ZERO
;
	PUSH	BX			;SAVE MESSAGE POINTER
	MOV	CL,WRCON		;CHARACTER OUTPUT FUNCTION CODE
	INT	224			;OUTPUT IT
	POP	BX
	JMPS	PRTMLP			;GO CHECK/DO NEXT CHAR
;
PMXIT:
	MOV	BP,SP			;RESTORE HL, RET ADDR
	XCHG	BX,[BP]
	RET				;RET PAST MSG
;
;
;CONVERT CHARACTER IN (A) TO UPPER CASE
;
UPCASE:
	AND	AL,07FH			;STRIP UPPER BIT
	CMP	AL,060H			;IS CHAR ONE REQUIRING CONVERT
	JNB	L_31	
	RET				;NO CONVERT NEEDED
L_31:
	AND	AL,05FH			;CONVERT
	RET
;
;
;CHECK FOR LEGAL FILE NAME CHARACTER
;
CHKLEGL:
	MOV	SI,DX			;GET CHARACTER FROM .(DE)
	MOV	AL,[SI]
	INC	DX			;TO POINT AT NEXT CHARACTER
	CMP	AL,' '			;IS IT LESS THAN SPACE
	JNB	L_32	
	RET				;RETURN CARRY IF ERROR CHAR
L_32:
	CMP	AL,05FH			;IF GREATER THAN UNDERSCORE ERROR
	JNB	CHKERR			;CARRY SET EXIT
	CMP	AL,'='
	JZ	CHKERR
	CMP	AL,':'
	JZ	CHKERR
	CMP	AL,';'
	JZ	CHKERR
	CMP	AL,'<'
	JZ	CHKERR
	CMP	AL,'>'
	JZ	CHKERR
	OR	AL,AL			;CLEAR CARRY FOR GOOD CHAR
	RET
;
CHKERR:
	STC				;ERROR EXIT
	RET
;
;
;ROUTINE TO COMPARE TWO STRINGS LEFT TO RIGHT SIMILAR TO CMP B INSTRUCTION
;
;	(B)=STRING LENGTH
;	(DE)=STRING A BASE POINTER
;	(HL)=STRING B BASE POINTER
;
CMPSTR:
	MOV	SI,DX			;GET AN A STRING CHARACTER
	MOV	AL,[SI]
	CMP	AL,M			;CHECK AGAINST B STRING CHARACTER
	JZ	L_33	
	RET				;NOT EQUAL SETS RETURN FLAGS
L_33:
	DEC	CH			;DECREMENT COMPARE BYTE COUNT
	JNZ	L_34	
	RET				;SET LIKE EQUAL IF ALL COMPARED EQUAL
L_34:
	INC	BX			;BUMP COMPARE POINTERS
	INC	DX
	JMPS	CMPSTR			;TO DO NEXT CHARACTER
;
;
;ROUTINE TO INTERCHANGE TWO STRINGS FOR SORTING
;
;	(B)=STRING LENGTH
;	(DE)=STRING A BASE POINTER
;	(HL)=STRING B BASE POINTER
;
SWAP:
	MOV	CL,M			;GET CHAR FROM ONE STRING
	MOV	SI,DX			;AND ONE FROM OTHER STRING
	MOV	AL,[SI]
	MOV	M,AL			;SECOND INTO FIRST
	MOV	AL,CL			;FIRST INTO SECOND
	MOV	SI,DX
	MOV	[SI],AL
	LAHF				;BUMP SWAP POINTERS
	INC	BX
	SAHF
	LAHF
	INC	DX
	SAHF
	DEC	CH			;SEE IF ALL BYTES SWAPPED YET
	JNZ	SWAP
	RET
; HIDDEN is an in-memory flag, never a CP/M filename attribute.
; Raw search with user '?' yields CDOS FAT's synthetic header. Version is
; only an initial gate: allocation bytes are decoded ONLY after that marker.
; No BDOS 230, DOS interrupt, sibling library or on-disk change is needed.
HB_PROBE:
 PUSH AX
 PUSH BX
 PUSH CX
 PUSH DX
 MOV Byte Ptr HB_FAT,0
 MOV CL,12
 INT 224
 CMP AL,41H
 JB HB_PROBE_DONE
 MOV CL,25
 INT 224
 MOV Byte Ptr HB_DRIVE,AL
 MOV DL,Byte Ptr .FCB
 OR DL,DL
 JZ HB_PROBE_SEARCH
 DEC DL
 MOV CL,14
 INT 224
HB_PROBE_SEARCH:
 MOV DX,Offset HB_RAW
 MOV CL,17
 INT 224
 CMP AL,0FFH
 JE HB_PROBE_RESTORE
 AND AX,3
 MOV CL,5
 SHL AX,CL
 MOV BX,AX
 ADD BX,BUFR
 CMP Byte Ptr [BX],20H
 JNE HB_PROBE_RESTORE
 CMP Byte Ptr 15[BX],80H
 JNE HB_PROBE_RESTORE
 CMP Word Ptr 16[BX],8080H
 JNE HB_PROBE_RESTORE
 MOV Byte Ptr HB_FAT,1
HB_PROBE_RESTORE:
 MOV DL,Byte Ptr HB_DRIVE
 MOV CL,14
 INT 224
HB_PROBE_DONE:
 POP DX
 POP CX
 POP BX
 POP AX
 RET
; BX is the found directory entry. Return carry if excluded. Preserve BX.
; Bit 0=RO, bit 1=FAT HIDDEN, bit 2=SYSTEM; low bits survive MOVBYT.
HB_FLAGS:
 XOR AL,AL
 TEST Byte Ptr 9[BX],80H
 JZ HB_FLAGS_SYS
 OR AL,1
HB_FLAGS_SYS:
 TEST Byte Ptr 10[BX],80H
 JZ HB_FLAGS_HIDDEN
 OR AL,4
HB_FLAGS_HIDDEN:
 CMP Byte Ptr HB_FAT,0
 JE HB_FLAGS_SELECT
 MOV AH,Byte Ptr 16[BX]
 CMP AH,Byte Ptr 17[BX]
 JNE HB_FLAGS_SELECT
 AND AH,0A0H
 CMP AH,0A0H
 JNE HB_FLAGS_SELECT
 OR AL,2
HB_FLAGS_SELECT:
 MOV Byte Ptr HB_LAST,AL
 CMP Byte Ptr HB_ALL,0
 JNE HB_FLAGS_KEEP
 TEST AL,6
 JZ HB_FLAGS_KEEP
 STC
 RET
HB_FLAGS_KEEP:
 CLC
 RET
HB_TOGGLE:
 XOR Byte Ptr HB_ALL,1
 JMP NAMEPRES
HB_EMPTY:
 CALL PRTMSG
 DB CR,LF,'No matching normal files. O toggles all; X exits: ',0
 MOV CL,KEYIN
 INT 224
 CALL UPCASE
 CMP AL,'O'
 JNE HB_EMPTY_EXIT
 JMP HB_TOGGLE
HB_EMPTY_EXIT:
 JMP EXIT
L_35	EQU	$
	DSEG
	ORG	Offset L_35
