;FILE PROCESSING AND DISPLAY WLOOP
;
CMDST:
	MOV	BX,(Offset FNLIST)	;SET START POINT OF LISTING
	MOV	Word Ptr LISTPOS,BX
;
;
;DISPLAY CURRENT FILE POSITION
;
WLOOP:
	MOV	BX,Word Ptr LISTPOS	;MOVE FROM LOCATION
	MOV	DX,(Offset PNAME)	;START POINT OF FNLIST POINT
	MOV	CH,1			;ONE CHARACTER OF DRIVE ID TO MOVE
	CALL	MOVBYT
;
	MOV	DX,(Offset PNAME)+3	;PLACE TO PUT FILE NAME FOR PRINT
	MOV	CH,8			;8 CHARS IN FILE NAME
	CALL	MOVBYT			;MOVE NAME FIELD
;
	MOV	DX,(Offset PNAME)+12	;PLACE TO PUT EXTENSION FOR PRINT
	MOV	CH,3			;3 CHARS IN FILE TYPE
	CALL	MOVBYT			;MOVE TYPE NAME
;
	MOV AL,M ; flags move with their filename through sort/delete
	MOV DI,Offset PNAME+15
	MOV Byte Ptr [DI],' '
	MOV Byte Ptr 1[DI],' '
	TEST AL,4
	JZ HB_NO_SYS
	MOV Byte Ptr [DI],'S'
HB_NO_SYS:
	TEST AL,2
	JZ HB_NO_HIDDEN
	MOV Byte Ptr 1[DI],'H'
HB_NO_HIDDEN:
	INC BX
	MOV	Word Ptr LISTPOS,BX	;next complete record
;
; ASM86 won't use the code label PNAME as a byte variable: go through DI,
; which the translation leaves free (8080 model, so CS=DS)
	MOV	DI,(Offset PNAME)
	MOV	AL,[DI]			;MAKE DRIVE NAME PRINTABLE
	ADD	AL,'A'-1		;THIS ONE O.K. SO MAKE DRIVE PRINTABLE
	MOV	[DI],AL
;
SAMEPOS:
	CALL	PRTMSG			;PRINT CURRENT READY TO TRANSFER FILE NAME
PNAME:
	DB	'X: XXXXXXXX.XXX   : '	;DUMMY FILE NAME PRINTING FIELD
	DB	0
;
	MOV	CL,KEYIN		;CONSOLE CHAR IN FUNCTION
	INT	224			;GET THE CHARACTER
	CALL	UPCASE
	CMP AL,'O'
	JNE HB_NOT_TOGGLE
	JMP HB_TOGGLE
HB_NOT_TOGGLE:
	CMP	AL,' '			;IF SPACE THEN ON TO NEXT FILE
	JNZ	L_6	
	JMP	NEXTPOS
L_6:
	CMP	AL,CR			;IF CARRIAGE RETURN THEN ON TO NEXT FILE
	JNZ	L_7	
	JMP	NEXTPOS
L_7:
	CMP	AL,'B'			;IF BACKUP THEN ADJUST POSITION POINTER -1 FILE
	JZ	BACKUP
	CMP	AL,'X'			;IF EXIT THEN TO CP/M
	JNZ	L_8	
	JMP	EXIT
L_8:
	CMP	AL,'R'			;IF RENAME THEN GO DO IT
	JNZ	L_9	
	JMP	RENAME
L_9:
	CMP	AL,EOT			;TO DELETE A FILE IF "^D"
	JNZ	L_10	
	JMP	DELFLE
L_10:
	CMP	AL,'V'			;IF TO VIEW FILE AT CONSOLE
	JNZ	L_11	
	JMP	VIEW
L_11:
	CMP	AL,'L'			;IF TO PRINT FILE TO FNLIST DEVICE
	JNZ	L_12	
	JMP	PRTFIL
L_12:
	CMP	AL,'P'			;IF TO SEND FILE TO THE PUNCH DEVICE
	JNZ	L_13	
	JMP	PUNFIL
L_13:
	CMP	AL,'C'			;IF TO COPY FILE TO ANOTHER DISK
	JNZ	L_14	
	JMP	COPY
L_14:
	CMP	AL,'S'			;IF TO START OVER ON ANOTHER DRIVE
	JNZ	L_15	
	JMP	LOG
L_15:
CMDERR:
	CALL	MENU			;GIVE HELP MESSAGE
	JMPS	SAMEPOS			;STAY IN THIS POSITION
;
BACKUP:
	MOV	BX,Word Ptr LISTPOS	;SEE IF AT BEGINNING OF FNLIST
	MOV	DX,(Offset FNLIST)+HB_STRIDE
	CALL	CMPDEHL
	JNZ	BAKUP1			;SKIP POSITION POINTER RESET IF NOT
;..AT BEGINNING
	CALL	PRTMSG
	DB	CR,LF,CR,LF,'      Beginning of List',CR,LF,0
	MOV	BX,Word Ptr LISTEND	;SET TO END +1 TO BACKUP TO END
	MOV	DX,HB_STRIDE
	ADD	BX,DX
	MOV	Word Ptr LISTPOS,BX
;
BAKUP1:
	CALL	PRTMSG			;PRINT BACKUP INDICATOR
	DB	CR,LF,'<  ',0
	MOV	BX,Word Ptr LISTPOS
	MOV	DX,HB_STRIDE*2			;ONE FNLIST POSITION BACKWARDS SIZE
	CALL	SDEHL			;SUBTRACT
	MOV	Word Ptr LISTPOS,BX
	JMP	WLOOP			;DISPLAY THAT GUY WITHOUT CRLF
;
NEXTPOS:
	CALL	PRTMSG			;DO CARRIAGE RETURN LINE FEED
	DB	CR,LF,0
	MOV	BX,Word Ptr LISTPOS	;SEE IF AT END OF WLOOP YET
	XCHG	BX,DX
	MOV	BX,Word Ptr LISTEND
	CALL	CMPDEHL			;COMPARE
	JZ	L_16	
	JMP	WLOOP			;GO ON TO NEXT POSITION TO PRINT
L_16:
;
;
;AT END OF DIRECTORY. PRINT MESSAGE AND GO BACK TO TOP
;
	CALL	PRTMSG			;PRINT END OF DIRECTORY MESSAGE
	DB	CR,LF,'      End of List',CR,LF,CR,LF,0
	MOV	BX,(Offset FNLIST)	;SET POSITION POINTER TO BEGINNING
	MOV	Word Ptr LISTPOS,BX
	JMP	WLOOP			;TO REDISPLAY START ENTRY
;
;
;CLEAN COMMAND WLOOP EXIT POINT TO CP/M
;
EXIT:
	MOV	CL,0			;BACK TO CP/M
	MOV	DL,0
	INT	224
;
;
;ROUTINE TO RENAME THE FILE CURRENTLY DISPLAYED
;
RENAME:
	MOV	BX,Word Ptr LISTPOS	;MOVE NAME FROM FNLIST TO RENAME FCB
	MOV	DX,HB_STRIDE
	CALL	SDEHL			;POINT TO NAME POSITION
	MOV	DX,(Offset DESTFCB)	;PLACE TO MOVE THE NAME
	MOV	CH,12			;AMOUNT TO MOVE
	CALL	MOVBYT
;
	CALL	PRTMSG			;NEW NAME PROMPT
	DB	'  New Name ? ',0
	MOV	CL,GETBUF		;GET COMMAND BUFFER FUNCTION
	MOV	DX,(Offset CBUFF)	;PLACE TO PUT COMMAND LINE
	INT	224
;
;
;CONVERT TO UPPER CASE
;
	MOV	BX,(Offset CBUFFL)	;GET BUFFER LENGTH
	MOV	CH,M			;..TO (B)
	XOR	AL,AL
	OR	AL,CH			;IF ZERO LENGTH SKIP RENAME
	JZ	NEXTPOS
;
CONV:
	INC	BX			;POINT AT A CHAR TO CONVERT
	MOV	AL,M
	CALL	UPCASE
	MOV	M,AL			;PUT BACK INTO BUFFER
	DEC	CH
	JNZ	CONV
;
;
;SCAN INPUT BUFFER TO MOVE A FILE NAME TO THE RENAME POSITION OF
;DESTINATION FCB
;
	MOV	BX,(Offset DESTFCB)+16
	MOV	M,0			;BDOS EXPECTS ZERO HERE
	INC	BX
;
;
;PREBLANK THE NEW FILE NAME FIELD
;
	PUSH	BX			;SAVE START POINTER
	MOV	CH,11			;NUMBER OF SPACES TO BLANK
PREFILL:
	MOV	M,' '			;PUT IN A SPACE CODE
	INC	BX
	DEC	CH			;CHECK BYTE COUNT TO SEE IF DONE
	JNZ	PREFILL
	POP	BX
;
	XCHG	BX,DX
	MOV	BX,(Offset CBUFFL)	;GET LENGTH TO (C)
	MOV	CL,M
	INC	BX
	XCHG	BX,DX			;(DE) = BUFFER POINTER
;..& (HL) = FCB POINTER
;
;
;PURGE SPACES OFF THE BEGINNING OF BUFFER
;
DEBLANK:
	MOV	SI,DX			;GET A CHARACTER
	MOV	AL,[SI]
	CMP	AL,' '
	JNZ	EXTND			;NOT BLANK, WE HAVE SOMETHING
	LAHF				;TO NEXT CHAR
	INC	DX
	SAHF
	DEC	CL
	JNZ	L_17	
	JMP	CMDERR			;ALL SPACES SO ERROR
L_17:
	JMPS	DEBLANK
;
;
;EXTEND BUFFER TO BLANKS BEYOND COMMAND LENGTH
;
EXTND:
	PUSH	BX
	MOV	BL,CL			;DOUBLE BYTE REMAINING LENGTH
	MOV	BH,0
	LAHF				;TO BUFFER END +1
	ADD	BX,DX
	RCR	SI,1
	SAHF
	RCL	SI,1
	MOV	M,' '			;FORCE ILLEGAL CHAR END
	POP	BX
;
;
;START FILE NAME SCAN
;
SCAN:
	MOV	CH,8			;MAX OF 8 CHAR IN FILE NAME
SCAN1:
	CALL	CHKLEGL			;GET AND SEE IF LEGAL CHARACTER
	JNB	L_18	
	JMP	CMDERR			;CHECK IF ALL OF COMMAND LINE
L_18:
	CMP	AL,' '			;SEE IF END OF PARAMETER FIELD
	JZ	CPYBITS			;GO TO RENAME THE FILE
	CMP	AL,'.'			;AT END OF FILE NAME
	JZ	SCAN2			;GO TO PROCESS THE FILE TYPE FIELD
	MOV	M,AL			;PUT CHAR INTO DESTINATION FCB
	LAHF
	INC	BX
	SAHF
	DEC	CH			;CHECK NAME CHARACTER COUNT
	JNZ	SCAN1
;
;
;GOT HERE IF EIGHT CHAR WITHOUT A "."
;
SCAN1A:
	CALL	CHKLEGL			;SCAN BUFFER UP TO PERIOD
;OR END
	JB	CPYBITS			;NO EXTENT IF NOT LEGAL
	CMP	AL,' '			;END OF PARAMETER FIELD?
	JZ	CPYBITS
	CMP	AL,'.'
	JZ	SCAN2			;NOW GO DO EXTENT FIELD
	JMPS	SCAN1A			;DO TILL END OR PERIOD
;
;
;NOW BUILD THE EXTENT FIELD
;
SCAN2:
	MOV	CH,3			;MAX LENGTH OF EXTENT FIELD
	MOV	BX,(Offset DESTFCB)+25	;DESTINATION RENAME EXTENT START
SCAN3:
	CALL	CHKLEGL			;GET AND CHECK CHARACTER
	JB	SCAN4			;NAME DONE IF ILLEGAL
	CMP	AL,' '			;END OF PARAMETER FIELD?
	JZ	SCAN4
	CMP	AL,'.'			;CHECK IF ANOTHER PERIOD
	JZ	SCAN4
	MOV	M,AL
	INC	BX
	DEC	CH
	JNZ	SCAN3			;GET NEXT EXTENT CHARACTER
;
SCAN4:
	MOV	CH,4			;FILL EX,S1,S2,RC WITH ZEROS
	MOV	BX,(Offset DESTFCB)+28	;SET POINTER TO RENAME EXTENT FIELD
SCAN5:
	MOV	M,0
	INC	BX
	DEC	CH
	JNZ	SCAN5
;
;
;COPY OLD FILES ATTRIBUTE BITS TO THE NEW FILE NAME TO HAVE THEN BE
;THE SAME AS OLD FILE NAME
;
CPYBITS:
	MOV	DX,(Offset DESTFCB)+1	;FIRST CHAR OF OLD NAME
	MOV	BX,(Offset DESTFCB)+17	;FIRST CHAR OF NEW NAME
	MOV	CL,011			;NUMBER OF BYTES WITH TAG BITS
CBITS1:
	MOV	SI,DX			;FETCH BIT OF OLD NAME CHAR
	MOV	AL,[SI]
	AND	AL,080H			;STRIP ONLY UPPER BIT OUT
	MOV	CH,AL			;SAVE BIT INTO (B)
	MOV	AL,07FH			;FETCH A MASK FOR CHAR ONLY
	AND	AL,M			;GET MASKED CHAR TO (A)
	OR	AL,CH			;PUT OLD BIT IN
	MOV	M,AL			;SAVE NEW BYTE BACK
	INC	BX			;BUMP COPY POINTERS
	INC	DX
	DEC	CL			;DEC BYTE COPY COUNT
	JNZ	CBITS1
;
;
;SEE IF THE NEW FILE NAME ALREADY EXISTS. IF SO SAY SO AND THEN GO
;TO THE COMMAND WLOOP AGAIN AT SAME POSITION
;
	MOV	AL,Byte Ptr DESTFCB	;COPY NEW NAME TO SOURCE FCB
	MOV	Byte Ptr SORCFCB,AL
	MOV	CH,11
	MOV	BX,(Offset DESTFCB)+17	;COPY NEW NAME TO
	MOV	DX,(Offset SORCFCB)+1	;..SOURCE FCB FOR EXISTENCE CHECK
	CALL	MOVBYT
	MOV	CH,4			;ZERO THE OPERATIONAL FIELDS
	MOV	BX,(Offset SORCFCB)+12
RNFILLP:
	MOV	M,0			;PUT A ZERO IN THERE
	INC	BX			;TAKE CARE OF COUNTERS
	DEC	CH
	JNZ	RNFILLP
;
	MOV	DX,(Offset SORCFCB)	;SEARCH TO SEE IF THIS FILE EXISTS
	MOV	CL,SRCHF		;SEARCH FIRST FUNCTION
	INT	224
	CMP	AL,0FFH			;RETURN CODE IF NOT FOUND
	JZ	RNFILE			;TO RENAME COMMAND IF NOT A DUPLICATE NAME
;
	CALL	PRTMSG			;ASK IF TO REPLACE
	DB	CR,LF,' ++ Name Already Exists ++',CR,LF,0
	JMP	SAMEPOS			;BACK TO LET HIM TRY ALL THAT AGAIN ON
;... THE SAME FILE NAME
;
;
;COPY NEW NAME INTO FNLIST POSITION IN CASE HE BACKS UP
;
RNFILE:
	MOV	BX,Word Ptr LISTPOS	;GET FNLIST POSITION POINTER
	MOV	DX,HB_STRIDE-1		;leave drive and trailing flags intact
	CALL	SDEHL
	XCHG	BX,DX
	MOV	BX,(Offset DESTFCB)+17	;POINT AT THE NEW NAME
	MOV	CH,11			;AMOUNT TO MOVE
	CALL	MOVBYT
;
;
;NOW DO THE RENAME BDOS FUNCTION
;
RNFIL1:
	MOV	DX,(Offset DESTFCB)	;RENAME FCB LOCATION
	MOV	CL,RENAM		;RENAME FUNCTION CODE
	INT	224			;GO DO IT
	CMP	AL,0FFH			;SEE IF RENAME ERROR
	JZ	L_19	
	JMP	NEXTPOS			;IF O.K. PROCEDE
L_19:
	CALL	PRTMSG			;OR ELSE PRINT ERROR MESSAGE
	DB	' ++ Not Found ++',0
	JMP	NEXTPOS			;GO TO NEXT FNLIST POSITION
;
;
;DELETE A FILE NAME AS SPECIFIED IN CURRENT POSITION POINTER
;
DELFLE:
	MOV	BX,Word Ptr LISTPOS	;MOVE NAME FROM FNLIST TO RENAME FCB
	MOV	DX,HB_STRIDE
	CALL	SDEHL			;POINT TO NAME POSITION
	MOV	DX,(Offset DESTFCB)	;PLACE TO MOVE THE NAME
	MOV	CH,12			;AMOUNT TO MOVE
	CALL	MOVBYT
;
;
;DELETE THE FILE NOW
;
	MOV	DX,(Offset DESTFCB)	;POINT AT DELETE FCB
	MOV	CL,DELETE		;DELETE FUNCTION CODE
	INT	224
;AVOID 1.4 BUG
	CMP	AL,0FFH
	JNZ	DELFL1			;FILE DELETED O.K.
	CALL	PRTMSG			;TYPE ERROR MESSAGE
	DB	' ++ Not Found ++',0
	JMP	NEXTPOS
;
DELFL1:
	CALL	PRTMSG			;SAY IT HAS BEEN DELETED
	DB	'  Deleted',0
;
;
;MOVE FNLIST UP ONE POSITION TO CLOSE UP THE ERASED POSITION
;
	MOV	BX,Word Ptr LISTPOS	;FIXUP MOVE UP POINTERS
	PUSH	BX
	MOV	DX,HB_STRIDE
	CALL	SDEHL
	MOV	Word Ptr LISTPOS,BX	;RESET CURRENT POSITION FOR MOVE
	XCHG	BX,DX			;(DE) = TO LOCATION
	POP	BX			;(HL) = FROM LOCATION
;
MOVUP:
	XCHG	BX,DX
	PUSH	BX			;CHECK IF AT END
	MOV	BX,Word Ptr LISTEND	;GET OLD END POINTER
	CALL	CMPDEHL			;CHECK AGAINST CURRENT END LOCATION
	POP	BX
	XCHG	BX,DX
	JZ	MOVDONE			;MUST BE AT END OF FNLIST
	MOV	CH,HB_STRIDE		;ONE NAME SIZE
	CALL	MOVBYT			;MOVE ONE NAME UP
	JMPS	MOVUP			;GO CHECK END PARAMETERS
;
MOVDONE:
	XCHG	BX,DX
	MOV	Word Ptr LISTEND,BX	;SET NEW FNLIST END IF ALL MOVED
	MOV	DX,(Offset FNLIST)	;SEE IF FNLIST IS EMPTY
	CALL	CMPDEHL			;..IE LISTEND=LISTPOS=FNLIST
	JZ	L_20	
	JMP	NEXTPOS
L_20:
	MOV	BX,Word Ptr LISTPOS
	CALL	CMPDEHL
	JZ	L_21	
	JMP	NEXTPOS			;NEITHER EQUAL SO NOT EMPTY
L_21:
	CALL	PRTMSG
	DB	CR,LF,CR,LF,'      List Empty',0
	JMP	EXIT			;BALE OUT IF DONE
;
;
;ENTRY POINT TO SEND CURRENT FILE NAME CONTENTS TO THE CONSOLE
;
VIEW:
	CALL	PRTMSG
	DB	CR,LF,CR,LF,0		;TURN UP TWO NEW LINES
	MOV	AL,WRCON		;WRITE CONSOLE OUT FUNCTION
	JMPS	OUTCM			;TO COMMON I/O PROCESSING
;
;
;ENTRY POINT TO SEND CURRENT FILE NAME CONTENTS TO THE FNLIST DEVICE
;
PRTFIL:
	MOV	AL,WRLST		;WRITE FNLIST DEVICE OUT FUNCTION
	JMPS	OUTCM			;TO COMMON I/O PROCESSING
;
;
;ENTRY POINT TO SEND CURRENT FILE NAME CONTENTS TO THE PUNCH DEVICE
;
PUNFIL:
	MOV	AL,WRPUN		;WRITE PUNCH DEVICE OUT FUNCTION
;
;
;COMMON OUTPUT CHARACTER I/O PROCESSING ENTRY
;
OUTCM:
	MOV	Byte Ptr OUTOP,AL	;SAVE BDOS FUNCTION
;
;
;FETCH THE FILE NAME TO SEND OUT
;
	MOV	BX,Word Ptr LISTPOS	;MOVE NAME FROM FNLIST TO SOURCE FCB
	MOV	DX,HB_STRIDE
	CALL	SDEHL			;POINT TO NAME POSITION
	MOV	DX,(Offset SORCFCB)	;PLACE TO MOVE THE NAME
	MOV	CH,12			;AMOUNT TO MOVE
	CALL	MOVBYT
;
	MOV	DX,BUFR			;SET TO USE DEFAULT DMA BUFFER
	MOV	CL,STDMA		;ADDRESS SET FUNCTION
	INT	224
;
	MOV	CH,4			;FILL EX,S1,S2,RC WITH ZEROS
	MOV	BX,(Offset SORCFCB)+12	;SET POINTER TO SOURCE EXTENT FIELD
OUTCM1:
	MOV	M,0
	INC	BX
	DEC	CH
	JNZ	OUTCM1
;
	MOV	DX,(Offset SORCFCB)	;OPEN THE FILE FOR READING
	MOV	CL,OPEN			;FILE OPEN FUNCTION CODE
	INT	224
	CMP	AL,0FFH
	JNZ	OUTCM2			;SKIP ERROR MESSAGE IF O.K.
	CALL	PRTMSG
	DB	' ++ File Cannot Be Opened ++',0
	JMP	NEXTPOS
;
OUTCM2:
	XOR	AL,AL			;ZERO THE CURRENT RECORD FIELD
	MOV	Byte Ptr SORCFCB+32,AL
;
OUTCM3:
	MOV	DX,(Offset SORCFCB)	;POINT AT FILE FCB FOR READING
	MOV	CL,READR		;FUNCTION SET FOR RECORD READ
	INT	224
	OR	AL,AL			;CHECK IF READ WAS O.K.
	JZ	OUTCM4			;READ O.K. SO GO TO SEND OUT
	JMP	NEXTPOS			;EOF SO TO NEXT FNLIST NAME POSITION
;
OUTCM4:
	MOV	BX,BUFR			;POINT AT SECTOR JUST READ
	MOV	CH,080H			;SET SECTOR CHARACTER COUNTER TO OUTPUT
OUTCM5:
	MOV	AL,M			;GET A CHARACTER
	CMP	AL,01AH			;SEE IF LOGICAL END OF FILE
	JNZ	L_22	
	JMP	NEXTPOS			;BACK TO FNLIST WLOOP IF LOG EOF
L_22:
	MOV	DL,AL			;POSITION CHARACTER FOR BDOS
	PUSH	CX
	PUSH	BX
	MOV	AL,Byte Ptr OUTOP	;GET DEVICE CODE FOR OUTPUT
	MOV	CL,AL
	INT	224			;SEND THE CHARACTER
;
	MOV	CL,GETST		;GET CONSOLE STATUS FUNCTION
	INT	224			;GO GET THE ABORT STATUS
	POP	BX
	POP	CX
;
	OR	AL,AL			;IF CHAR THERE, THEN ABORT
	JZ	L_23	
	JMP	BACKUP			;  TO SAME FNLIST POSITION
L_23:
;
	INC	BX			;INC BUFFER POINTER
	DEC	CH			;ALL BYTES OF SECTOR SENT YET?
	JNZ	OUTCM5			;MORE TO DO
;
	JMPS	OUTCM3			;GO GET THE NEXT SECTOR
;
;
;ROUTINE TO COPY A DISK FILE NAMED BY THE CURRENT FNLIST POSITON TO
;A DIFFERENT DISK DRIVE OF OPERATOR SELECTION.
;
