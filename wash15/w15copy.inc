COPY:
	MOV	BX,Word Ptr LISTPOS	;MOVE NAME FROM FNLIST TO SOURCE FCB
	MOV	DX,HB_STRIDE
	CALL	SDEHL			;POINT TO NAME POSITION
	MOV	DX,(Offset SORCFCB)	;PLACE TO MOVE THE NAME
	MOV	CH,12			;AMOUNT TO MOVE
	CALL	MOVBYT
;
	MOV	CH,4			;FILL EX,S1,S2,RC WITH ZEROS
	MOV	BX,(Offset SORCFCB)+12	;SET POINTER TO SOURCE EXTENT FIELD
COPY1:
	MOV	M,0			;PUT ZERO IN
	INC	BX
	DEC	CH
	JNZ	COPY1
;
	XOR	AL,AL			;ZERO THE CURRENT RECORD FIELD
	MOV	Byte Ptr SORCFCB+32,AL
;
	MOV	CH,33			;COPY SOURCE FCB TO DESTINATION FCB
	MOV	BX,(Offset SORCFCB)	;FROM COPY POINT
	MOV	DX,(Offset DESTFCB)	;TO COPY POINT
	CALL	MOVBYT			;MOVE IT ACROSS
;
	MOV	DX,(Offset SORCFCB)	;OPEN THE FILE FOR READING
	MOV	CL,OPEN			;FILE OPEN FUNCTION CODE
	INT	224
	CMP	AL,0FFH
	JNZ	COPY2			;SKIP ERROR MESSAGE IF O.K.
	CALL	PRTMSG
	DB	CR,LF,' ++ Source File Cannot Be Opened ++',0
	JMP	NEXTPOS
;
COPY2:
	CALL	PRTMSG			;PROMPT FOR DRIVE SELECT NAME
	DB	'  Destination Drive ? ',0
	MOV	CL,KEYIN		;GET SELECTION
	INT	224
	CALL	UPCASE			;CONVERT TO UPPER CASE
	SUB	AL,'A'			;ZERO BASE FOR RANGE CHECK
	CMP	AL,'P'-'A'+1
	JNAE	L_24	
	JMP	CMDERR			;BACK TO COMMAND WLOOP WITH "?"
L_24:
;
	INC	AL			;BASE DRIVE SELECT FOR 1=A:
	MOV	Byte Ptr DESTFCB,AL	;SET INTO THE DESTINATION FCB
;
	MOV	CH,AL			;SEE IF HE PICKED SAME DISK AS CURRENT
	MOV	AL,Byte Ptr SORCFCB	;GET SOURCE DRIVE ID
	CMP	AL,CH
	JNZ	COPY2A			;NO THEY ARE DIFFERENT?
	CALL	PRTMSG
	DB	CR,LF,' ++ Cannot Select Same Disk as Source ++',CR,LF,0
	JMP	SAMEPOS			;LET HIM TRY AGAIN
;
COPY2A:
	MOV	DX,(Offset DESTFCB)	;SEARCH TO SEE IF THIS FILE EXISTED
	MOV	CL,SRCHF		;SEARCH FIRST FUNCTION
	INT	224
	CMP	AL,0FFH			;RETURN CODE IF NOT FOUND
	JZ	COPY3			;GO TO MAKE FUNCTION FOR NEW FILE
;
	CALL	PRTMSG			;ASK IF TO REPLACE
	DB	'  Replace ? ',0
	MOV	CL,KEYIN		;GET HIS ANSWER
	INT	224
	CALL	UPCASE
	CMP	AL,'Y'			;IF YES THEN DELETE IT AND COPY OVER
	JZ	L_25	
	JMP	NEXTPOS			;IF COPY NOT WANTED THEN ON TO NEXT
L_25:
;
	MOV	DX,(Offset DESTFCB)	;DELETE FILE THAT ALREADY EXISTS
	MOV	CL,DELETE		;ERASE FILE FUNCTION CODE
	INT	224
;
COPY3:
	MOV	DX,(Offset DESTFCB)	;MAKE NEW FILE AND OPEN FOR WRITING
	MOV	CL,MAKE			;MAKE FUNCTION CODE
	INT	224			;GO MAKE IT
	CMP	AL,0FFH			;CHECK IF THE DIRECTORY WAS FULL
	JNZ	COPY4
	CALL	PRTMSG
	DB	CR,LF,' ++ Destination Directory Full ++',0
	JMP	NEXTPOS			;BACK TO FNLIST PROCESSOR IF ERROR
;
COPY4:
	MOV	AX,Word Ptr MEMTOP
	SUB	AX,Word Ptr BUFSTART
	JNC	COPY5
	XOR	AX,AX
COPY5:
	MOV	CL,7
	SHR	AX,CL			;whole 128-byte records within allocation
	MOV	CX,AX
;
	MOV	AL,CH			;CHECK IF ANY MEMORY FOR COPY AT ALL
	OR	AL,CL
	JNZ	COPY6			;THERE IS MEMORY FOR BUFFER
	CALL	PRTMSG
	DB	CR,LF,' ++ No Memory Available for Copy Buffer ++',0
	JMP	NEXTPOS
;
COPY6:
	MOV	BL,CL
	MOV	BH,CH			;PUT MAX SECTOR COUNT IN STORAGE
	MOV	Word Ptr BUFMAX,BX
	XOR	AL,AL			;CLEAR EOF FLAG
	MOV	Byte Ptr EOFLG,AL
;
COPY6A:
	MOV	BX,0			;SET CURRENT BUFFER COUNTER TO ZERO
	MOV	Word Ptr BUFCNT,BX
	MOV	BX,Word Ptr BUFSTART	;SET BUFFER START POINTER TO BEGIN
	MOV	Word Ptr BUFPNT,BX
;
;
;FILE SOURCE READING WLOOP TO READ ALL MEMORY FULL OR STOP ON EOF
;
COPY7:
	MOV	BX,Word Ptr BUFPNT	;SET DMA ADDRESS TO BUFFER POINTER
	XCHG	BX,DX
	MOV	CL,STDMA
	INT	224
;
	MOV	DX,(Offset SORCFCB)	;POINT AT FILE FCB FOR READING
	MOV	CL,READR		;FUNCTION SET FOR RECORD READ
	INT	224
	OR	AL,AL			;CHECK IF READ WAS O.K. OF EOF
	JZ	COPY7_DATA
	CMP	AL,1
	JZ	COPY8			;only status 1 is end of file
	JMP	COPY_READ_ERROR
COPY7_DATA:
;
	MOV	BX,Word Ptr BUFPNT	;SET BUFFER POINTER UP ONE SECTOR
	MOV	DX,080H
	LAHF
	ADD	BX,DX
	SAHF
	MOV	Word Ptr BUFPNT,BX
	MOV	BX,Word Ptr BUFCNT	;INCREASE BUFFER SECTOR COUNT
	LAHF
	INC	BX
	SAHF
	MOV	Word Ptr BUFCNT,BX
	XCHG	BX,DX			;CHECK TO SEE IF MEMORY IS FULL
	MOV	BX,Word Ptr BUFMAX	;MAXIMUM SECTOR COUNT
	CALL	CMPDEHL			;COMPARE
	JNZ	COPY7			;IF NOT FULL GO GET NEXT SECTOR
	JMPS	COPY9			;GO HANDLE WRITE OPERATION
;
;
;HERE IF READ OPERATION INDICATES THAT THE FILE IS AT ITS END ON READ
;
COPY8:
	MOV	AL,0FFH			;SET EOF FLAG
	MOV	Byte Ptr EOFLG,AL
;
;
;WRITE OUTPUT FILE PROCESSING WLOOP TO SEND MEMORY BUFFER TO
;DESTINATION DISK FILE
;
COPY9:
	MOV	BX,Word Ptr BUFSTART	;SET BUFFER POINTER TO START
	MOV	Word Ptr BUFPNT,BX
;
COPY10:
	MOV	BX,Word Ptr BUFCNT	;SEE IF BUFFER IS EMPTY YET
	MOV	AL,BH
	OR	AL,BL
	JZ	COPY11			;BUFFER EMPTY SO CHECK EOF FLAG
	DEC	BX			;DEC BUFFER SECTOR COUNT FOR EACH WRITE
	MOV	Word Ptr BUFCNT,BX
;
	MOV	BX,Word Ptr BUFPNT	;SET UP DMA ADDRESS
	PUSH	BX			;SAVE FOR SIZE BUMP
	XCHG	BX,DX
	MOV	CL,STDMA
	INT	224
	POP	BX
	MOV	DX,080H			;INCREASE ADDRESS FOR SECTOR SIZE
	ADD	BX,DX
	MOV	Word Ptr BUFPNT,BX
;
	MOV	DX,(Offset DESTFCB)	;POINT TO OUTPUT FILE FCB
	MOV	CL,WRITER		;WRITE RECORD FUNCTION CODE
	INT	224			;GO WRITE
	OR	AL,AL			;CHECK IF ANY ERROR-CAF
	JZ	COPY10			;O.K. SO DO NEXT RECORD
;
	CALL	PRTMSG			;TELL OF DISK WRITE ERROR
	DB	CR,LF,' ++ Disk or Directory Full or error on Write ++',0	;ts
	JMP	NEXTPOS			;BACK TO FNLIST PROCESSING
;
COPY11:
	MOV	AL,Byte Ptr EOFLG	;BUFFER ALL WRITTEN SO GO CHECK EOF
	OR	AL,AL
	JNZ	L_26	
	JMP	COPY6A			;GO TO READ NEXT BUFFER FULL
L_26:
;
	MOV	DX,(Offset DESTFCB)	;POINT AT FCB FOR FILE CLOSE
	MOV	CL,CLOSE		;CLOSE FILE FUNCTION CODE
	INT	224
	CMP	AL,0FFH			;CHECK IF CLOSE ERROR
	JZ	L_27	
	JMP	NEXTPOS
L_27:
	CALL	PRTMSG
	DB	CR,LF,' ++ Destination Close Error ++',0
	JMP	NEXTPOS
;
COPY_READ_ERROR:
	CALL	PRTMSG
	DB	CR,LF,' ++ Source Read Error - Copy Aborted ++',0
	MOV	DX,(Offset DESTFCB)
	MOV	CL,CLOSE
	INT	224
	CMP	AL,0FFH
	JNE	COPY_DISCARD
	CALL	PRTMSG
	DB	CR,LF,' ++ Destination Close Error ++',0
COPY_DISCARD:
	MOV	DX,(Offset DESTFCB)
	MOV	CL,DELETE
	INT	224
	CMP	AL,0FFH
	JNE	COPY_SOURCE_CLOSE
	CALL	PRTMSG
	DB	CR,LF,' ++ Incomplete Destination Cannot Be Deleted ++',0
COPY_SOURCE_CLOSE:
	MOV	DX,(Offset SORCFCB)
	MOV	CL,CLOSE
	INT	224
	CMP	AL,0FFH
	JNE	COPY_ERROR_DONE
	CALL	PRTMSG
	DB	CR,LF,' ++ Source Close Error ++',0
COPY_ERROR_DONE:
	MOV	DX,BUFR
	MOV	CL,STDMA
	INT	224
	JMP	NEXTPOS
;
;
;ROUTINE TO INQUIRE ABOUT SELECTING OPERATION ON ANOTHER DRIVE
;
LOG:
	CALL	PRTMSG			;PROMPT FOR DRIVE SELECT NAME
	DB	'  New Drive ? ',0
	MOV	CL,KEYIN		;GET SELECTION
	INT	224
	CALL	UPCASE			;CONVERT TO UPPER CASE
	CMP	AL,CR			;IF CARRIAGE RETURN SKIP RE-LOG
	JNZ	L_28	
	JMP	NEXTPOS
L_28:
;
	SUB	AL,'A'			;ZERO BASE FOR RANGE CHECK
	CMP	AL,'P'-'A'+1
	JNAE	L_29	
	JMP	CMDERR			;BACK TO COMMAND WLOOP WITH "?"
L_29:
;
	INC	AL			;BASE DRIVE SELECT FOR 1=A:
	MOV	Byte Ptr .FCB,AL	;SET INTO THE START DEFAULT FCB
	MOV	AL,' '			;SET DEFAULT FCB TO LOOK LIKE *.*
	MOV	Byte Ptr .FCB+1,AL
	MOV	Byte Ptr .FCB+9,AL
;
; DISK RESET ROUTINE	(Vers. 1.5 Simon Ewins)
;
	MOV	CL,0DH			;CALL BDOS RESET
	INT	224
;
	JMP	RESTART			;GO RESTART WITH MENU PRINT OVER
;
;
