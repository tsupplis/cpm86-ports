;	OPCODE INTERPRETER FOR CB PREFIX FUNCTIONS
;
;	CB opcodes are decoded rather than tabled:
;	  bits 7-6  00 rotate/shift, 01 BIT, 10 RES, 11 SET
;	  bits 5-3  rotate/shift type or bit number
;	  bits 2-0  B C D E H L (HL) A
;
CODECB:					;CB PREFIX, BL = CB OPCODE
	INC	SI
	MOV	CL,BL
	MOV	BH,0
	AND	BL,7
	CMP	BL,6
	JE	CBHL
	MOV	BL,CBREG[BX]
	ADD	BX,OFFSET Z_REGISTERS
	MOV	AL,[BX]
	CALL	CBCORE
	MOV	[BX],AL
	RET
CBHL:	MOV	BX,Z_HL
	MOV	AL,ES:[BX]
	CALL	CBCORE
	MOV	ES:[BX],AL
	RET
CBREG	DB	1,0,3,2,5,4,6,7		;B C D E H L - A -> Z_REGISTERS
;
;	CBCORE: AL = operand, CL = CB opcode, AH = Z80 flags
;	returns AL = result and the Z80 flags; preserves BX
;
CBCORE:	MOV	CH,CL
	SHR	CH,1
	SHR	CH,1
	SHR	CH,1
	AND	CH,7
	TEST	CL,0C0H
	JNZ	CBBRS
	MOV	Z_NF,0
	MOV	DL,CH
	XOR	DH,DH
	SHL	DX,1
	MOV	DI,DX
	MOV	DX,CBTBL[DI]
	SAHF				;Z80 CARRY IN, FOR RL AND RR
	JMP	DX
CBRLC:	ROL	AL,1
	JMPS	CBSZP
CBRRC:	ROR	AL,1
	JMPS	CBSZP
CBRL:	RCL	AL,1
	JMPS	CBSZP
CBRR:	RCR	AL,1
	JMPS	CBSZP
CBSLA:	SHL	AL,1
	JMPS	CBSZP
CBSRA:	SAR	AL,1
	JMPS	CBSZP
CBSLL:	STC
	RCL	AL,1
	JMPS	CBSZP
CBSRL:	SHR	AL,1
CBSZP:	LAHF				;C FROM THE SHIFT, S Z P FROM AL
	AND	AH,1
	MOV	DL,AH
	OR	AL,AL
	LAHF
	AND	AH,0C4H
	OR	AH,DL
	SAHF
	RET
CBBRS:	MOV	DL,1			;DL = 1 SHL BIT NUMBER
	XCHG	CL,CH
	SHL	DL,CL
	XCHG	CL,CH
	MOV	DH,CL
	AND	DH,0C0H
	CMP	DH,40H
	JE	CBBIT
	CMP	DH,80H
	JE	CBRES
	OR	AL,DL			;SET
	SAHF
	RET
CBRES:	NOT	DL
	AND	AL,DL
	SAHF
	RET
CBBIT:	MOV	Z_NF,0
	AND	AH,1			;KEEP C, H=1
	OR	AH,10H
	TEST	AL,DL
	JNZ	CBBT1
	OR	AH,44H			;Z AND P/V WHEN THE BIT IS 0
CBBT1:	AND	DL,AL
	AND	DL,80H			;S WHEN BIT 7 IS SET
	OR	AH,DL
	SAHF
	RET
