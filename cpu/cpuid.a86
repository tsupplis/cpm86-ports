;
;  Detection logic replaced with the newer, more capable version (8086/NEC/
;  186/286/386/486, FPU, MSW, IDTR, CR0) and ported to ASM-86.
;  ASM-86 only knows 8086/8087 instructions, so every 186+/286+/386+
;  instruction is emitted with DB and commented with what it really is.
;
CPU_86  equ     0
CPU_NEC equ     1
CPU_186 equ     2
CPU_286 equ     3
CPU_386 equ     4
CPU_486 equ     5
;
        cseg                    ;start of code segment
        org     100h            ;leave room for base page
;
start:
        mov     ax,cs           ;point ds
        mov     ds,ax           ;at our own segment
        mov     dx,offset tcpu
        call    print
        call    getcpu          ;al = CPU_xxx
        cbw
        push    ax              ;remember the cpu type
        xchg    si,ax
        shl     si,1
        mov     dx,ttab[si]     ;name of the cpu
        call    print
        mov     dx,offset tcdate
        call    print
        push    ds              ;retain our code/data segment
        mov     ax,0FFFFh       ;legacy date source segment
        mov     ds,ax
        mov     si,5            ;legacy date field offset
        mov     cx,8            ;eight date characters from legacy routine
date_loop:
        push    cx
        lodsb
        mov     dl,al
        call    putc            ;shared BDOS output routine; preserves registers
        pop     cx
        loop    date_loop
        pop     ds
;
; FPU check. FNSTSW AX only exists on the 287 and later, so use the memory
; form, preset to non-zero. FNINIT/FNSTSW don't wait for the coprocessor,
; so burn a few cycles after each.
;
        mov     fpustat,0ffffh
        db      0DBh,0E3h       ;fninit
        mov     cx,20
fdly1:  loop    fdly1
        db      0DDh,3Eh        ;fnstsw fpustat (DD /7, direct address)
        dw      offset fpustat
        mov     cx,20
fdly2:  loop    fdly2
        mov     ax,fpustat
        cmp     al,0            ;status word low byte is 0 after reset
        jne     nofpu
        mov     dx,offset mfpu
        call    print
        jmp     fpucont
nofpu:
        mov     dx,offset mnofpu
        call    print
fpucont:
        pop     ax
        cmp     al,CPU_286
        jnb     getmsw          ;286 or better, go on
        mov     dx,offset crnl
        call    print
        jmp     quit
;
; 286 and up: MSW and IDTR
;
getmsw:
        push    ax
        mov     dx,offset tmsw
        call    print
        db      0Fh,01h,0E0h    ;smsw ax
        call    hex2
        mov     dx,offset tibase
        call    print
        sub     sp,6
        mov     bp,sp
        db      0Fh,01h,4Eh,00h ;sidt [bp]
        pop     cx              ;limit
        pop     dx              ;base, low word
        pop     ax              ;base, high word
        call    hex2
        xchg    ax,dx
        call    hex2
        mov     dx,offset tilimit
        call    print
        xchg    ax,cx
        call    hex2
        pop     ax              ;cpu type
        cmp     al,CPU_386
        jnb     getcr           ;386 or better, go on
        cmp     al,CPU_486
        jnb     getcr
        jmp     quit
;
; 386 and up: CR0, then CR0 after clearing it
;
getcr:
        push    ax
        mov     dx,offset tcr0
        call    print
        db      0Fh,20h,0C0h    ;mov eax,cr0
        db      66h,50h         ;push eax
        call    hex3
        mov     dx,offset tccr0
        call    print
        db      66h,31h,0C0h    ;xor eax,eax
        db      0Fh,22h,0C0h    ;mov cr0,eax
        db      0EBh,00h        ;jmp short $+2 (flush prefetch)
        db      0Fh,20h,0C0h    ;mov eax,cr0
        db      66h,59h         ;pop ecx
        db      0Fh,22h,0C1h    ;mov cr0,ecx
        db      0EBh,00h        ;jmp short $+2
        call    hex3
        pop     ax
quit:
        xor     cx,cx           ;function 0 - reset system
        int     224             ;call BDOS
;
; Print the $-terminated string at ds:dx. Preserves all registers, as the
; BDOS returns its result in ax/bx and uses cx for the function number.
;
print:
        push    ax
        push    bx
        push    cx
        push    dx
        push    si
        push    di
        push    bp
        push    ds
        push    es
        mov     cl,9            ;function 9 - print string
        int     224
        pop     es
        pop     ds
        pop     bp
        pop     di
        pop     si
        pop     dx
        pop     cx
        pop     bx
        pop     ax
        ret
;
; Print the character in dl. Preserves all registers.
;
putc:
        push    ax
        push    bx
        push    cx
        push    dx
        push    si
        push    di
        push    bp
        push    ds
        push    es
        mov     cl,2            ;function 2 - console output
        int     224
        pop     es
        pop     ds
        pop     bp
        pop     di
        pop     si
        pop     dx
        pop     cx
        pop     bx
        pop     ax
        ret
;
; Detect the cpu. Returns al = CPU_xxx
;
getcpu:
        sub     sp,6
        push    sp
        pop     bp
        cmp     sp,bp           ;8086/186 push sp-2, 286+ push sp
        je      is286
        mov     ax,0ffffh
        mov     cl,21h
        shr     ax,cl           ;186+ mask the count to 5 bits, 86 doesn't
        or      al,al
        mov     al,CPU_186
        jnz     gdone
        mov     ax,0101h        ;NEC runs AAD with base 10 always
        db      0D5h,10h        ;aad 16
        cmp     al,11h          ;Intel gives 11h, NEC gives 0Bh
        mov     al,CPU_NEC
        jne     gdone
        mov     al,CPU_86
gdone:
        add     sp,6
        ret
is286:
        db      0Fh,01h,4Eh,00h ;sidt [bp]
        pop     ax
        pop     ax
        pop     ax              ;top byte of base: FFh on a 286, 0 on a 386+
        or      ah,ah
        mov     al,CPU_286
        jnz     gdone2
        db      66h,9Ch         ;pushfd
        db      66h,58h         ;pop eax
        db      66h,89h,0C1h    ;mov ecx,eax
        db      66h,35h,00h,00h,04h,00h ;xor eax,40000h  (flip EFLAGS.AC)
        db      66h,50h         ;push eax
        db      66h,9Dh         ;popfd
        db      66h,9Ch         ;pushfd
        db      66h,58h         ;pop eax
        db      66h,31h,0C8h    ;xor eax,ecx
        jz      is386           ;AC can't be toggled: 386
        db      66h,51h         ;push ecx
        db      66h,9Dh         ;popfd
        mov     al,CPU_486
        jmp     gdone2
is386:
        mov     al,CPU_386
gdone2:
        ret
;
; Print ax as 4 hex digits. Preserves all registers.
;
hex2:
        push    ax
        push    bx
        push    cx
        push    dx
        mov     bx,ax
        mov     ch,4            ;4 digits
hexloop:
        mov     cl,4
        rol     bx,cl
        mov     ax,bx
        and     al,0fh
        cmp     al,0ah
        sbb     al,69h
        das
        mov     dl,al
        call    putc
        dec     ch
        jnz     hexloop
        pop     dx
        pop     cx
        pop     bx
        pop     ax
        ret
;
; Print eax as 8 hex digits.
;
hex3:
        db      66h,50h         ;push eax
        db      66h,0C1h,0C0h,10h ;rol eax,16
        call    hex2            ;high word
        db      66h,58h         ;pop eax
        jmp     hex2            ;low word
;
; Data
;
fpustat dw      0
tcpu    db      'Type: $'
tcdate  db      13,10,'Date: $'
ttab    dw      offset t86,offset tnec,offset t186
        dw      offset t286,offset t386,offset t486
t86     db      '8088/8086$'
tnec    db      'V20/V30$'
t186    db      '188/186$'
t286    db      '286$'
t386    db      '386$'
t486    db      '486+$'
mfpu    db      13,10,'FPU: 80x87$'
mnofpu  db      '$'
tmsw    db      13,10,'MSW: 0x$'
tibase  db      13,10,'IDTR: Base 0x$'
tilimit db      ' Limit 0x$'
tcr0    db      13,10,'CR0: 0x$'
tccr0   db      13,10,'Cleared CR0: 0x$'
crnl    db      13,10,'$'
;
        end
