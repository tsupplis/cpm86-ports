;	OPCODE INTERPRETER FOR ED PREFIX FUNCTIONS
;
;	ED 40-7F AND A0-BF ARE TABLED IN EDADDR.Z80, THE REST ARE NOPS.
;	ON ENTRY TO A COEDxx ROUTINE: SI POINTS PAST THE ED OPCODE,
;	BX = THE WORD THAT FOLLOWS, FLAGS AND AH = THE Z80 FLAGS.
;
CODEED:					;ED PREFIX, BL = ED OPCODE
	INC	SI
	MOV	DI,BX
	AND	DI,0FFH
	MOV	BX,ES:[SI]
	CMP	DI,40H
	JB	EDNOP
	CMP	DI,0C0H
	JAE	EDNOP
	CMP	DI,80H
	JB	EDOK
	CMP	DI,0A0H
	JB	EDNOP
EDOK:	AND	DI,7FH
	SUB	DI,20H
	SHL	DI,1
	MOV	CX,EDTBL[DI]
	SAHF
	JMP	CX
EDNOP:	SAHF
	RET
;
;	IN r,(C) / OUT (C),r
;
EDIN:	MOV	DL,Z_C
	MOV	DH,0
	IN	AL,DX
	MOV	[DI],AL
	MOV	Z_NF,0
;
;	SZPKC: FLAGS = S Z P OF AL, H=0, C FROM AH
;
SZPKC:	AND	AH,1
	MOV	DL,AH
	OR	AL,AL
	LAHF
	AND	AH,0C4H
	OR	AH,DL
	SAHF
	RET
EDOUT:	MOV	DL,Z_C
	MOV	DH,0
	OUT	DX,AL
	RET
;
;	SBC HL,rr / ADC HL,rr
;
EDSBC:	MOV	AX,Z_HL
	SBB	AX,DX
	MOV	Z_HL,AX
	JMP	OVSUB
EDADC:	MOV	AX,Z_HL
	ADC	AX,DX
	MOV	Z_HL,AX
	JMP	OVADD
;
;	LD (nn),rr / LD rr,(nn)   DI -> REGISTER PAIR
;
EDSTW:	INC	SI
	INC	SI
	SAHF
	MOV	DX,[DI]
	MOV	ES:[BX],DX
	RET
EDLDW:	INC	SI
	INC	SI
	SAHF
	MOV	DX,ES:[BX]
	MOV	[DI],DX
	RET

COED40:
	MOV	DI,OFFSET Z_B		;IN r,(C)
	JMP	EDIN
COED41:
	MOV	AL,Z_B		;OUT (C),r
	JMP	EDOUT
COED42:
	MOV	DX,Z_BC
	JMP	EDSBC
COED43:
	MOV	DI,OFFSET Z_BC
	JMP	EDSTW
COED44:
	NEG	Z_A			;NEG
	JMP	OVSUB
COED45:
	JMP	Z80_RET			;RETN / RETI
COED46:
	RET				;IM n
COED47:
	MOV	AL,Z_A			;LD I,A
	MOV	Z_I,AL
	RET
COED48:
	MOV	DI,OFFSET Z_C		;IN r,(C)
	JMP	EDIN
COED49:
	MOV	AL,Z_C		;OUT (C),r
	JMP	EDOUT
COED4A:
	MOV	DX,Z_BC
	JMP	EDADC
COED4B:
	MOV	DI,OFFSET Z_BC
	JMP	EDLDW
COED4C:
	NEG	Z_A			;NEG
	JMP	OVSUB
COED4D:
	JMP	Z80_RET			;RETN / RETI
COED4E:
	RET				;IM n
COED4F:
	MOV	AL,Z_A			;LD R,A
	MOV	Z_R,AL
	RET
COED50:
	MOV	DI,OFFSET Z_D		;IN r,(C)
	JMP	EDIN
COED51:
	MOV	AL,Z_D		;OUT (C),r
	JMP	EDOUT
COED52:
	MOV	DX,Z_DE
	JMP	EDSBC
COED53:
	MOV	DI,OFFSET Z_DE
	JMP	EDSTW
COED54:
	NEG	Z_A			;NEG
	JMP	OVSUB
COED55:
	JMP	Z80_RET			;RETN / RETI
COED56:
	RET				;IM n
COED57:
	MOV	AL,Z_I			;LD A,I
	JMP	EDLDA
COED58:
	MOV	DI,OFFSET Z_E		;IN r,(C)
	JMP	EDIN
COED59:
	MOV	AL,Z_E		;OUT (C),r
	JMP	EDOUT
COED5A:
	MOV	DX,Z_DE
	JMP	EDADC
COED5B:
	MOV	DI,OFFSET Z_DE
	JMP	EDLDW
COED5C:
	NEG	Z_A			;NEG
	JMP	OVSUB
COED5D:
	JMP	Z80_RET			;RETN / RETI
COED5E:
	RET				;IM n
COED5F:
	MOV	AL,Z_R			;LD A,R
	ADD	AL,15H
	ADD	AL,BL
	MOV	Z_R,AL
	JMP	EDLDA
COED60:
	MOV	DI,OFFSET Z_H		;IN r,(C)
	JMP	EDIN
COED61:
	MOV	AL,Z_H		;OUT (C),r
	JMP	EDOUT
COED62:
	MOV	DX,Z_HL
	JMP	EDSBC
COED63:
	MOV	DI,OFFSET Z_HL
	JMP	EDSTW
COED64:
	NEG	Z_A			;NEG
	JMP	OVSUB
COED65:
	JMP	Z80_RET			;RETN / RETI
COED66:
	RET				;IM n
COED67:
	JMP	EDRRD
COED68:
	MOV	DI,OFFSET Z_L		;IN r,(C)
	JMP	EDIN
COED69:
	MOV	AL,Z_L		;OUT (C),r
	JMP	EDOUT
COED6A:
	MOV	DX,Z_HL
	JMP	EDADC
COED6B:
	MOV	DI,OFFSET Z_HL
	JMP	EDLDW
COED6C:
	NEG	Z_A			;NEG
	JMP	OVSUB
COED6D:
	JMP	Z80_RET			;RETN / RETI
COED6E:
	RET				;IM n
COED6F:
	JMP	EDRLD
COED70:
	MOV	DI,OFFSET Z_TEMP		;IN r,(C)
	JMP	EDIN
COED71:
	MOV	AL,0		;OUT (C),r
	JMP	EDOUT
COED72:
	MOV	DX,Z_SP
	JMP	EDSBC
COED73:
	MOV	DI,OFFSET Z_SP
	JMP	EDSTW
COED74:
	NEG	Z_A			;NEG
	JMP	OVSUB
COED75:
	JMP	Z80_RET			;RETN / RETI
COED76:
	RET				;IM n
COED77:
	RET				;NOP
COED78:
	MOV	DI,OFFSET Z_A		;IN r,(C)
	JMP	EDIN
COED79:
	MOV	AL,Z_A		;OUT (C),r
	JMP	EDOUT
COED7A:
	MOV	DX,Z_SP
	JMP	EDADC
COED7B:
	MOV	DI,OFFSET Z_SP
	JMP	EDLDW
COED7C:
	NEG	Z_A			;NEG
	JMP	OVSUB
COED7D:
	JMP	Z80_RET			;RETN / RETI
COED7E:
	RET				;IM n
COED7F:
	RET				;NOP
EDLDA:	MOV	Z_A,AL			;P/V = IFF2, TAKEN AS SET
	MOV	Z_NF,0
	CALL	SZPKC
	LAHF
	OR	AH,4
	SAHF
	RET
;
;	RRD / RLD   A = a, (HL) = m
;
EDRRD:	MOV	BX,Z_HL
	MOV	AL,ES:[BX]
	MOV	DL,Z_A
	MOV	CL,4
	MOV	DH,AL
	AND	DH,0FH
	SHR	AL,CL
	MOV	CH,DL
	AND	CH,0FH
	SHL	CH,CL
	OR	AL,CH			;(HL) = a.lo:m.hi
	JMPS	EDRXD
EDRLD:	MOV	BX,Z_HL
	MOV	AL,ES:[BX]
	MOV	DL,Z_A
	MOV	CL,4
	MOV	DH,AL
	SHR	DH,CL			;m.hi
	SHL	AL,CL
	MOV	CH,DL
	AND	CH,0FH
	OR	AL,CH			;(HL) = m.lo:a.lo
EDRXD:	MOV	ES:[BX],AL
	AND	DL,0F0H
	OR	DL,DH
	MOV	Z_A,DL
	MOV	AL,DL
	MOV	Z_NF,0
	JMP	SZPKC
;
;	LDI / LDD   DX = STEP
;
EDLDI:	MOV	BX,Z_HL
	MOV	CL,ES:[BX]
	MOV	DI,Z_DE
	MOV	ES:[DI],CL
	ADD	Z_HL,DX
	ADD	Z_DE,DX
	DEC	Z_BC
	MOV	Z_NF,0
EDPV:	AND	AH,0EBH			;H=0, P/V = BC<>0
	CMP	Z_BC,0
	JE	EDPV1
	OR	AH,4
EDPV1:	SAHF
	RET
;
;	LDIR / LDDR
;
EDLDR:	PUSH	SI
	PUSH	DS
	MOV	CX,Z_BC
	MOV	DI,Z_DE
	MOV	SI,Z_HL
	PUSH	ES
	POP	DS
	JCXZ	EDLDR0
	REP	MOVSB
	JMPS	EDLDR1
EDLDR0:	MOVSB				;BC=0 MEANS 64K
	DEC	CX
	REP	MOVSB
EDLDR1:	POP	DS
	CLD
	MOV	Z_HL,SI
	MOV	Z_DE,DI
	MOV	Z_BC,0
	POP	SI
	MOV	Z_NF,0
	AND	AH,0EBH
	SAHF
	RET
;
;	CPI / CPD / CPIR / CPDR   DX = STEP, CH = REPEAT
;
EDCP:	AND	AH,1
	MOV	CL,AH			;CL = C
	MOV	AL,Z_A
EDCPL:	MOV	BX,Z_HL
	ADD	Z_HL,DX
	DEC	Z_BC
	CMP	AL,ES:[BX]
	JE	EDCPX
	OR	CH,CH
	JZ	EDCPX
	CMP	Z_BC,0
	JNE	EDCPL
EDCPX:	CMP	AL,ES:[BX]
	LAHF
	AND	AH,0D0H			;S Z H
	OR	AH,CL
	CMP	Z_BC,0
	JE	EDCPY
	OR	AH,4
EDCPY:	MOV	Z_NF,1
	SAHF
	RET
;
;	INI / IND / INIR / INDR, OUTI / OUTD / OTIR / OTDR
;	DI = STEP, CH = REPEAT
;
EDINB:	MOV	DL,Z_C
	MOV	DH,0
	IN	AL,DX
	MOV	BX,Z_HL
	MOV	ES:[BX],AL
	ADD	Z_HL,DI
	DEC	Z_B
	JZ	EDIOX
	OR	CH,CH
	JNZ	EDINB
	JMPS	EDIOX
EDOUTB:	MOV	BX,Z_HL
	MOV	AL,ES:[BX]
	DEC	Z_B
	MOV	DL,Z_C
	MOV	DH,0
	OUT	DX,AL
	ADD	Z_HL,DI
	CMP	Z_B,0
	JE	EDIOX
	OR	CH,CH
	JNZ	EDOUTB
EDIOX:	AND	AH,1
	CMP	Z_B,0
	JNE	EDIOY
	OR	AH,40H
EDIOY:	MOV	Z_NF,1
	SAHF
	RET

COEDA0:
	MOV	DX,1			;LDI
	JMP	EDLDI
COEDA1:
	MOV	DX,1			;CPI
	MOV	CH,0
	JMP	EDCP
COEDA2:
	MOV	DI,1			;INI
	MOV	CH,0
	JMP	EDINB
COEDA3:
	MOV	DI,1			;OUTI
	MOV	CH,0
	JMP	EDOUTB
COEDA4:
	RET				;NOP
COEDA5:
	RET				;NOP
COEDA6:
	RET				;NOP
COEDA7:
	RET				;NOP
COEDA8:
	MOV	DX,-1			;LDD
	JMP	EDLDI
COEDA9:
	MOV	DX,-1			;CPD
	MOV	CH,0
	JMP	EDCP
COEDAA:
	MOV	DI,-1			;IND
	MOV	CH,0
	JMP	EDINB
COEDAB:
	MOV	DI,-1			;OUTD
	MOV	CH,0
	JMP	EDOUTB
COEDAC:
	RET				;NOP
COEDAD:
	RET				;NOP
COEDAE:
	RET				;NOP
COEDAF:
	RET				;NOP
COEDB0:
	CLD				;LDIR
	JMP	EDLDR
COEDB1:
	MOV	DX,1			;CPIR
	MOV	CH,1
	JMP	EDCP
COEDB2:
	MOV	DI,1			;INIR
	MOV	CH,1
	JMP	EDINB
COEDB3:
	MOV	DI,1			;OTIR
	MOV	CH,1
	JMP	EDOUTB
COEDB4:
	RET				;NOP
COEDB5:
	RET				;NOP
COEDB6:
	RET				;NOP
COEDB7:
	RET				;NOP
COEDB8:
	STD				;LDDR
	JMP	EDLDR
COEDB9:
	MOV	DX,-1			;CPDR
	MOV	CH,1
	JMP	EDCP
COEDBA:
	MOV	DI,-1			;INDR
	MOV	CH,1
	JMP	EDINB
COEDBB:
	MOV	DI,-1			;OTDR
	MOV	CH,1
	JMP	EDOUTB
COEDBC:
	RET				;NOP
COEDBD:
	RET				;NOP
COEDBE:
	RET				;NOP
COEDBF:
	RET				;NOP
