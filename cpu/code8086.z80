;		*** CODE8086.Z80 ***	VERSION 1.0	09/25/84
;	LAST EDIT 9/25/84
;
;	8086 INSTRUCTIONS TO EMULATE Z80 OP CODES
;
CODE00:					;NOP
	RET
CODE01:					;LD BC,nnnn
	INC	SI
	INC	SI
	MOV	Z_BC,BX
	SAHF
	RET
CODE02:					;LD (BC),A
	MOV	BX,Z_BC
	MOV	AL,Z_A
	MOV	ES:[BX],AL
	RET
CODE03:					;INC BC
	INC	Z_BC
	SAHF
	RET
CODE04:					;INC B
	INC	Z_B
	JMP	OVADD
CODE05:					;DEC B
	DEC	Z_B
	JMP	OVSUB
CODE06:					;LD B,nn
	INC	SI
	MOV	Z_B,BL
	SAHF
	RET
CODE07:					;RLCA
	ROL	Z_A,1
	RET
CODE08:							;EX AF,AF'
	CALL	GETAF
	XCHG	DX,Z_ALTA
	JMP	SETAF
CODE09:					;ADD HL,BC
	PUSHF
	MOV	AX,Z_BC
	ADD	Z_HL,AX
	JMP	CYSAV
CODE0A:					;LD A,(BC)
	MOV	BX,Z_BC
	MOV	AL,ES:[BX]
	MOV	Z_A,AL
	RET
CODE0B:					;DEC BC
	DEC	Z_BC
	SAHF
	RET
CODE0C:					;INC C
	INC	Z_C
	JMP	OVADD
CODE0D:					;DEC C
	DEC	Z_C
	JMP	OVSUB
CODE0E:					;LD C,nn
	INC	SI
	MOV	Z_C,BL
	SAHF
	RET
CODE0F:					;RRCA
	ROR	Z_A,1
	RET
CODE10:							;DJNZ
	INC	SI
	SAHF
	PUSHF
	DEC	Z_B
	JZ	DJNZ1
	POPF
	JMP	RELJMP
DJNZ1:	POPF
	RET
CODE11:					;LD DE,nnnn
	INC	SI
	INC	SI
	MOV	Z_DE,BX
	SAHF
	RET
CODE12:					;LD (DE),A
	MOV	BX,Z_DE
	MOV	AL,Z_A
	MOV	ES:[BX],AL
	RET
CODE13:					;INC DE
	INC	Z_DE
	SAHF
	RET
CODE14:					;INC D
	INC	Z_D
	JMP	OVADD
CODE15:					;DEC D
	DEC	Z_D
	JMP	OVSUB
CODE16:					;LD D,nn
	INC	SI
	MOV	Z_D,BL
	SAHF
	RET
CODE17:					;RLA
	RCL	Z_A,1
	RET
CODE18:							;JR dd
	INC	SI
	SAHF
	JMPS	RELJMP
CODE19:					;ADD HL,DE
	PUSHF
	MOV	AX,Z_DE
	ADD	Z_HL,AX
CYSAV:	JC	CYSET
CYCLR:	POPF
	CLC
	RET
CYSET:	POPF
	STC
	RET
CODE1A:					;LD A,(DE)
	MOV	BX,Z_DE
	MOV	AL,ES:[BX]
	MOV	Z_A,AL
	RET
CODE1B:					;DEC DE
	DEC	Z_DE
	SAHF
	RET
