	INC	Z_E
	JMP	OVADD
CODE1D:					;DEC E
	DEC	Z_E
	JMP	OVSUB
CODE1E:					;LD E,nn
	INC	SI
	MOV	Z_E,BL
	SAHF
	RET
CODE1F:					;RRA
	RCR	Z_A,1
	RET
CODE20:							;JR NZ,dd
	INC	SI
	SAHF
	JNZ	RELJMP
	RET
RELJMP:	MOV	AL,BL
	CBW
	PUSHF
	ADD	SI,AX
	POPF
	RET
CODE21:					;LD HL,nnnn
	INC	SI
	INC	SI
	MOV	Z_HL,BX
	SAHF
	RET
