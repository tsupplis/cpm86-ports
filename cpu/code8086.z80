CODE25:					;DEC H
	DEC	Z_H
	JMP	OVSUB
CODE26:					;LD H,nn
	INC	SI
	MOV	Z_H,BL
	SAHF
	RET
CODE27:					;DAA
	CMP	Z_NF,0
	JNE	DAA1
	MOV	AL,Z_A
	SAHF
	DAA
	MOV	Z_A,AL
	RET
DAA1:	MOV	AL,Z_A
	SAHF
	DAS
	MOV	Z_A,AL
	RET
CODE28:							;JR Z,dd
	INC	SI
	SAHF
	JZ	RELJMP
	RET
CODE29:					;ADD HL,HL
	PUSHF
	MOV	AX,Z_HL
	ADD	Z_HL,AX
	JMP	CYSAV
CODE2A:					;LD HL,(nnnn)
	INC	SI
	INC	SI
	SAHF
	MOV	AX,ES:[BX]
	MOV	Z_HL,AX
	RET
CODE2B:					;DEC HL
	DEC	Z_HL
	SAHF
	RET
CODE2C:					;INC L
	INC	Z_L
	JMP	OVADD
CODE2D:					;DEC L
	DEC	Z_L
	JMP	OVSUB
CODE2E:					;LD L,nn
	INC	SI
	MOV	Z_L,BL
	SAHF
	RET
CODE2F:					;CPL
	NOT	Z_A
	RET
CODE30:							;JR NC,dd
	INC	SI
	SAHF
	JC	RET30
RJMP2:	JMP	RELJMP
RET30:	RET
CODE31:					;LD SP,nnnn
	INC	SI
	INC	SI
	MOV	Z_SP,BX
	SAHF
	RET
CODE32:					;LD (nnnn),A
	INC	SI
	INC	SI
	MOV	AL,Z_A
	MOV	ES:[BX],AL
	SAHF
	RET
CODE33:					;INC SP
	INC	Z_SP
	SAHF
	RET
CODE34:					;INC (HL)
	MOV	BX,Z_HL
	INC	ES: BYTE PTR [BX]
	JMP	OVADD
CODE35:					;DEC (HL)
	MOV	BX,Z_HL
	DEC	ES: BYTE PTR [BX]
	JMP	OVSUB
CODE36:					;LD (HL),nn
	INC	SI
	MOV	AL,BL
	MOV	BX,Z_HL
	MOV	ES:[BX],AL
	SAHF
	RET
CODE37:					;SCF
	STC
	RET
CODE38:							;JR C,dd
	INC	SI
	SAHF
	JC	RJMP2
	RET
CODE39:					;ADD HL,SP
	PUSHF
	MOV	AX,Z_SP
	ADD	Z_HL,AX
	JMP	CYSAV
CODE3A:					;LD A,(nnnn)
