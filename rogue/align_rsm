#!/usr/bin/env python3
import sys
import struct
import os

def align_rsm(rsm_path):
    if not os.path.exists(rsm_path):
        print(f"Error: {rsm_path} not found", file=sys.stderr)
        return False

    with open(rsm_path, "r+b") as f:
        f.seek(0x0C)
        data = f.read(4)
        if len(data) < 4:
            print(f"Error: {rsm_path} header too short", file=sys.stderr)
            return False
        data_size, udata_size = struct.unpack("<HH", data)
        dorg = data_size + udata_size

        if dorg % 2 != 0:
            new_udata = udata_size + 1
            f.seek(0x0E)
            f.write(struct.pack("<H", new_udata))
            print(f"[align_rsm] {rsm_path}: Data={data_size:#04X} Udata={udata_size:#04X} -> {new_udata:#04X} (Total Data Org: {dorg:#04X} -> {data_size+new_udata:#04X})")
        else:
            print(f"[align_rsm] {rsm_path}: Already even-aligned (Data Org: {dorg:#04X})")
    return True

def main():
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <file.rsm> [file2.rsm ...]", file=sys.stderr)
        sys.exit(1)
    for path in sys.argv[1:]:
        align_rsm(path)

if __name__ == "__main__":
    main()
